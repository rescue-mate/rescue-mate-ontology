    <!-- http://rescue-mate.de/ontology/DementiaCareLivingArea -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DementiaCareLivingArea">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Facility"/>
        <rdfs:comment xml:lang="de">Anlage für das betreute Wohnen von Demenzpatienten</rdfs:comment>
        <rdfs:comment xml:lang="en">Facility providing assisted living for dementia patients</rdfs:comment>
        <rdfs:label xml:lang="en">Dementia care living area</rdfs:label>
        <rdfs:label xml:lang="de">Wohnbereich Demenz</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/PVSPatientCareUnit -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/PVSPatientCareUnit">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Facility"/>
        <rdfs:comment xml:lang="en">Facility that is specialized in care for patients in a persistent vegetative state (PVS)</rdfs:comment>
        <rdfs:label xml:lang="en">PVS patient care unit</rdfs:label>
        <rdfs:label xml:lang="de">Versorgung von Wachkomapatienten</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/ResidentialFacility -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/ResidentialFacility">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Facility"/>
        <rdfs:comment xml:lang="de">Anlage für die Langzeitpflege und Betreuung</rdfs:comment>
        <rdfs:comment xml:lang="en">Long-term care facility providing supervision and assistance</rdfs:comment>
        <rdfs:label xml:lang="de">Pflegeeinrichtung</rdfs:label>
        <rdfs:label xml:lang="en">Residential facility</rdfs:label>
    </owl:Class>
</rdf:RDF>



