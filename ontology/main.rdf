<?xml version="1.0"?>
<rdf:RDF xmlns="http://rescue-mate.de/ontology/"
     xml:base="http://rescue-mate.de/ontology/"
     xmlns:cc="http://creativecommons.org/ns#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:dct="http://purl.org/dc/terms/"
     xmlns:fno="https://w3id.org/function/ontology#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:core="http://purl.org/vocab/frbr/core#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:schema="http://schema.org/"
     xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://rescue-mate.de/ontology/main">
        <owl:versionIRI rdf:resource="http://rescue-mate.de/ontology/main/0.6.0"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/bfo/2019-08-26/bfo.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/iao/2022-11-07/iao.owl"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/wikidata-bridge/0.6.0"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/fixed_construction/0.6.0"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/operational_resources/0.6.0"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/functions/0.6.0"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/social_media/0.6.0"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/events/0.6.0"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/care_facilities/0.6.0"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov-o-inverses-20130430"/>
        <owl:imports rdf:resource="https://w3id.org/function/ontology/1.0.0"/>
        <cc:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dct:created>2025-02-12</dct:created>
        <dct:creator>Patrick Westphal</dct:creator>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-07</dct:issued>
        <dct:modified>2025-11-07</dct:modified>
        <dct:rights xml:lang="en">CC BY 4.0 - RESCUE-MATE Project</dct:rights>
        <dct:title xml:lang="en">RESCUE-MATE Ontology</dct:title>
        <dct:title xml:lang="de">RESCUE-MATE-Ontologie</dct:title>
        <rdfs:comment xml:lang="de">Haupt-Ontologie-Modul zur Unterstützung der Datenintegration im RESCUE-MATE-Projekt</rdfs:comment>
        <rdfs:comment xml:lang="en">Main ontology module supporting the data integration part of the RESCUE-MATE project</rdfs:comment>
        <owl:priorVersion rdf:resource="http://rescue-mate.de/ontology/main/0.5.0"/>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://creativecommons.org/ns#license -->

    <owl:AnnotationProperty rdf:about="http://creativecommons.org/ns#license"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/issued -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/rights -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/rights"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/hasOperator -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/hasOperator">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/Facility"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/JuridicalPerson"/>
        <rdfs:label xml:lang="en">has operator</rdfs:label>
        <rdfs:label xml:lang="de">hat Betreiber</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rescue-mate.de/ontology/hasPosition -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/hasPosition">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/Position"/>
        <rdfs:comment xml:lang="de">Beziehung zwischen einem Objekt und einer Position (d.h. einem Raum-Zeit-Punkt)</rdfs:comment>
        <rdfs:comment xml:lang="en">Relation between an object and a position (being a point in space-time)</rdfs:comment>
        <rdfs:label xml:lang="en">has position</rdfs:label>
        <rdfs:label xml:lang="de">hat Position</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/maximumOccupancy -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/maximumOccupancy">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="de">maximale Belegung</rdfs:label>
        <rdfs:label xml:lang="en">maximum occupancy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/averageDwellingSizeInSquareMeters -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/averageDwellingSizeInSquareMeters">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/CityDistrict"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="de">durchschnittliche Wohnungsgröße in Quadratmetern</rdfs:label>
        <rdfs:label xml:lang="en">average dwelling size in square meters</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/dwellingsInOneAndTwoFamilyHousesInPercent -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/dwellingsInOneAndTwoFamilyHousesInPercent">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/CityDistrict"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="de">Anteil der Wohnungen in Ein- und Zweifamilienhäusern in Prozent</rdfs:label>
        <rdfs:label xml:lang="en">dwellings in one and two family houses in percent</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/livingSpacePerResidentInSquareMeters -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/livingSpacePerResidentInSquareMeters">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/CityDistrict"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="de">Wohnfläche je Einwohner in Quadratmetern</rdfs:label>
        <rdfs:label xml:lang="en">living space per resident in square meters</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/numberOfDwellings -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/numberOfDwellings">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/CityDistrict"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="de">Anzahl der Wohnungen</rdfs:label>
        <rdfs:label xml:lang="en">number of dwellings</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/direction -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/direction">
        <rdfs:label xml:lang="en">direction</rdfs:label>
        <rdfs:label xml:lang="de">himmelsrichtung</rdfs:label>
    </owl:AnnotationProperty>



    <!-- http://rescue-mate.de/ontology/responsible -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/responsible">
        <rdfs:label xml:lang="en">responsible</rdfs:label>
        <rdfs:label xml:lang="de">zuständig</rdfs:label>
    </owl:AnnotationProperty>



    <!-- http://rescue-mate.de/ontology/toBeImplementedAtWaterLevelMark0 -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/toBeImplementedAtWaterLevelMark0">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">to be implemented at water level mark 0</rdfs:label>
        <rdfs:label xml:lang="de">umzusetzen bei Wasserstandstufe 0</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/toBeImplementedAtWaterLevelMark1 -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/toBeImplementedAtWaterLevelMark1">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">to be implemented at water level mark 1</rdfs:label>
        <rdfs:label xml:lang="de">umzusetzen bei Wasserstandstufe 1</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/toBeImplementedAtWaterLevelMark2 -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/toBeImplementedAtWaterLevelMark2">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">to be implemented at water level mark 2</rdfs:label>
        <rdfs:label xml:lang="de">umzusetzen bei Wasserstandstufe 2</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/toBeImplementedAtWaterLevelMark3 -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/toBeImplementedAtWaterLevelMark3">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">to be implemented at water level mark 3</rdfs:label>
        <rdfs:label xml:lang="de">umzusetzen bei Wasserstandstufe 3</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/toBeImplementedAtWaterLevelMark4 -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/toBeImplementedAtWaterLevelMark4">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">to be implemented at water level mark 4</rdfs:label>
        <rdfs:label xml:lang="de">umzusetzen bei Wasserstandstufe 4</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/OSMWaySegment -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/OSMWaySegment">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/WaySegment"/>
        <rdfs:comment xml:lang="en">A way segment that is defined in the free geo database OpenStreetMap</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein Streckenabschnitt der in der freien Geo-Datenbank OpenStreetMap definiert ist</rdfs:comment>
        <rdfs:label xml:lang="en">OpenStreetMap way segment</rdfs:label>
        <rdfs:label xml:lang="de">Streckenabschnitt in OpenStreetMap</rdfs:label>
    </owl:Class>



    <!-- http://rescue-mate.de/ontology/RoadClosure -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/RoadClosure">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:comment xml:lang="de">Der Zustand einer Straße, der eine Durchfahrt verbietet</rdfs:comment>
        <rdfs:comment xml:lang="en">The disposition of a road of not permitting passing</rdfs:comment>
        <rdfs:label xml:lang="en">Road closure</rdfs:label>
        <rdfs:label xml:lang="de">Straßensperrung</rdfs:label>
    </owl:Class>



    <!-- http://rescue-mate.de/ontology/WaySegment -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/WaySegment">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:comment xml:lang="en">A site that is defined by a way part of a physical infrastructure</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine Örtlichkeit die durch eine Strecke als Teil einer physischen Infrastruktur definiert ist</rdfs:comment>
        <rdfs:label xml:lang="de">Streckenabschnitt</rdfs:label>
        <rdfs:label xml:lang="en">Way segment</rdfs:label>
    </owl:Class>



    <!-- http://rescue-mate.de/ontology/restrictsAccess -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/restrictsAccess">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/RoadClosure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="de">Die Sperrung schränkt den Zugang zu Anliegern oder Einrichtungen ein</rdfs:comment>
        <rdfs:comment xml:lang="en">The closure restricts access to residents or facilities</rdfs:comment>
        <rdfs:label xml:lang="de">schränkt Zugang ein</rdfs:label>
        <rdfs:label xml:lang="en">restricts access</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/restrictsPublicTransport -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/restrictsPublicTransport">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/RoadClosure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="de">Die Sperrung schränkt den öffentlichen Personennahverkehr ein</rdfs:comment>
        <rdfs:comment xml:lang="en">The closure restricts public transport</rdfs:comment>
        <rdfs:label xml:lang="de">schränkt ÖPNV ein</rdfs:label>
        <rdfs:label xml:lang="en">restricts public transport</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/restrictsParking -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/restrictsParking">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/RoadClosure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="de">Die Sperrung schränkt den verfügbaren Parkraum ein</rdfs:comment>
        <rdfs:comment xml:lang="en">The closure restricts the available parking space</rdfs:comment>
        <rdfs:label xml:lang="de">schränkt Parkraum ein</rdfs:label>
        <rdfs:label xml:lang="en">restricts parking</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/isTrafficHotspot -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/isTrafficHotspot">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/RoadClosure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="de">Die Sperrung gilt als Verkehrsschwerpunkt mit besonderer Auswirkung</rdfs:comment>
        <rdfs:comment xml:lang="en">The closure is considered a traffic hotspot with particular impact</rdfs:comment>
        <rdfs:label xml:lang="de">ist Verkehrsschwerpunkt</rdfs:label>
        <rdfs:label xml:lang="en">is traffic hotspot</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/constructionStartDate -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/constructionStartDate">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/RoadClosure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="de">Datum, an dem die Baumaßnahme beginnt</rdfs:comment>
        <rdfs:comment xml:lang="en">Date the construction work starts</rdfs:comment>
        <rdfs:label xml:lang="de">Baubeginn</rdfs:label>
        <rdfs:label xml:lang="en">construction start date</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/constructionEndDate -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/constructionEndDate">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/RoadClosure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="de">Datum, an dem die Baumaßnahme endet</rdfs:comment>
        <rdfs:comment xml:lang="en">Date the construction work ends</rdfs:comment>
        <rdfs:label xml:lang="de">Bauende</rdfs:label>
        <rdfs:label xml:lang="en">construction end date</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/Activity -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Activity">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:comment xml:lang="en">A process executed by an agent that has a certin outcome</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein Prozess, der von einem Agenten ausgeführt wird und ein bestimmtes Ergebnis hat</rdfs:comment>
        <rdfs:label xml:lang="en">Activity</rdfs:label>
        <rdfs:label xml:lang="de">Tätigkeit</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q1914636</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Agent -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Agent">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:comment xml:lang="en">An independent continuant that bears some form of responsibility for an activity taking place</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein independent continuant der eine gewisse Verantwortlichkeit in Bezug auf eine Aktivität hat</rdfs:comment>
        <rdfs:label xml:lang="de">Agent</rdfs:label>
        <rdfs:label xml:lang="en">Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Aircraft -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Aircraft">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Vehicle"/>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q11436</rdfs:seeAlso>
        <rdfs:label xml:lang="en">Aircraft</rdfs:label>
        <rdfs:label xml:lang="de">Luftfahrzeug</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Campaign -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Campaign">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/IntentionalHumanActivity"/>
        <rdfs:comment xml:lang="de">Abfolge von über einen definierten Zeitraum geplanten oder tatsächlich ausgeführten Aktionen die einem gemeinsamen Zweck dienen.</rdfs:comment>
        <rdfs:comment xml:lang="en">Series of actions planned for or executed during a defined time period that serve a common goal</rdfs:comment>
        <rdfs:label xml:lang="en">Campaign</rdfs:label>
        <rdfs:label xml:lang="de">Kampagne</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q6056746</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Change -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Change">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:comment xml:lang="en">Process, event or action that acts on the current state of something and generates a new state that deviates from the previous state</rdfs:comment>
        <rdfs:comment xml:lang="de">Prozess, Ereignis oder Handlung, die auf den Zustand von etwas einwirkt und einen neuen Zustand schafft, der von dem vorherigen Zustand abweicht</rdfs:comment>
        <rdfs:label xml:lang="en">Change</rdfs:label>
        <rdfs:label xml:lang="de">Veränderung</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q1150070</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/CityDistrict -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/CityDistrict">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
        <rdfs:comment xml:lang="de">Stadtteil als administrative Untergliederung einer Stadt</rdfs:comment>
        <rdfs:comment xml:lang="en">Administrative subdivision of a city</rdfs:comment>
        <rdfs:label xml:lang="de">Stadtteil</rdfs:label>
        <rdfs:label xml:lang="en">City district</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.wikidata.org/wiki/Q734818"/>
    </owl:Class>



    <!-- http://rescue-mate.de/ontology/Container -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Container">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:comment xml:lang="de">Großraum-Behälter zur Lagerung und zum Transport von Gütern</rdfs:comment>
        <rdfs:comment xml:lang="en">Large-capacity freight unit for the storage and transport of goods</rdfs:comment>
        <rdfs:label xml:lang="de">Container</rdfs:label>
        <rdfs:label xml:lang="en">Container</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/CrisisMitigation -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/CrisisMitigation">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Mitigation"/>
        <rdfs:comment xml:lang="en">Process of reducting harm caused by a crisis</rdfs:comment>
        <rdfs:comment xml:lang="de">Vorgang der Verringerung von Schäden, die duch eine Krise entstanden sind</rdfs:comment>
        <rdfs:label xml:lang="en">Crisis mitigation</rdfs:label>
        <rdfs:label xml:lang="de">Schadensminderung in einer Krise</rdfs:label>
    </owl:Class>
    


