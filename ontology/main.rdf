<?xml version="1.0"?>
<rdf:RDF xmlns="http://rescue-mate.de/ontology/"
     xml:base="http://rescue-mate.de/ontology/"
     xmlns:cc="http://creativecommons.org/ns#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:dct="http://purl.org/dc/terms/"
     xmlns:fno="https://w3id.org/function/ontology#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:core="http://purl.org/vocab/frbr/core#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:schema="http://schema.org/"
     xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://rescue-mate.de/ontology/main">
        <owl:versionIRI rdf:resource="http://rescue-mate.de/ontology/main/0.6.0"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/bfo/2019-08-26/bfo.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/iao/2022-11-07/iao.owl"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/wikidata-bridge/0.6.0"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/fixed_construction/0.6.0"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/operational_resources/0.6.0"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov-o-inverses-20130430"/>
        <owl:imports rdf:resource="https://w3id.org/function/ontology/1.0.0"/>
        <cc:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dct:created>2025-02-12</dct:created>
        <dct:creator>Patrick Westphal</dct:creator>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-07</dct:issued>
        <dct:modified>2025-11-07</dct:modified>
        <dct:rights xml:lang="en">CC BY 4.0 - RESCUE-MATE Project</dct:rights>
        <dct:title xml:lang="en">RESCUE-MATE Ontology</dct:title>
        <dct:title xml:lang="de">RESCUE-MATE-Ontologie</dct:title>
        <rdfs:comment xml:lang="de">Haupt-Ontologie-Modul zur Unterstützung der Datenintegration im RESCUE-MATE-Projekt</rdfs:comment>
        <rdfs:comment xml:lang="en">Main ontology module supporting the data integration part of the RESCUE-MATE project</rdfs:comment>
        <owl:priorVersion rdf:resource="http://rescue-mate.de/ontology/main/0.5.0"/>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://creativecommons.org/ns#license -->

    <owl:AnnotationProperty rdf:about="http://creativecommons.org/ns#license"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/issued -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/rights -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/rights"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://rescue-mate.de/ontology/hasCategory -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/hasCategory">
        <rdfs:label xml:lang="en">has category</rdfs:label>
        <rdfs:label xml:lang="de">hat Kategorie</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://rescue-mate.de/ontology/hasClientMessageId -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/hasClientMessageId">
        <rdfs:label xml:lang="en">has client message ID</rdfs:label>
        <rdfs:label xml:lang="de">hat Client-Nachrichten-ID</rdfs:label>
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/Message"/>
    </owl:AnnotationProperty>
    


    <!-- http://rescue-mate.de/ontology/hasDetectedCategory -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/hasDetectedCategory">
        <rdfs:label xml:lang="en">has detected category</rdfs:label>
        <rdfs:label xml:lang="de">hat erkannte Kategorie</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://rescue-mate.de/ontology/hasIncidentNumber -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/hasIncidentNumber">
        <rdfs:label xml:lang="en">has incident number</rdfs:label>
        <rdfs:label xml:lang="de">hat Vorfall-Nummer</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://rescue-mate.de/ontology/hasSubCategory -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/hasSubCategory">
        <rdfs:label xml:lang="en">has sub-category</rdfs:label>
        <rdfs:label xml:lang="de">hat Subkategorie</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://rescue-mate.de/ontology/hasThreadID -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/hasThreadID">
        <rdfs:label xml:lang="en">has thread ID</rdfs:label>
        <rdfs:label xml:lang="de">hat Thread-ID</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/identifier"/>
    </owl:AnnotationProperty>
    


    <!-- http://rescue-mate.de/ontology/messageAuthorRole -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/messageAuthorRole">
        <rdfs:label xml:lang="de">Autorenrolle der Nachricht</rdfs:label>
        <rdfs:label xml:lang="en">message author role</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/hasNotification -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/hasNotification">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/NotificationEvent"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:comment xml:lang="en">A relation between a notification event and an information content entity containing the actual notification.</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine Relation zwischen einem Benachrichtigungsereignis und einem Information Content Entity, das die eigentliche Benachrichtigung trägt.</rdfs:comment>
        <rdfs:label xml:lang="en">has notification</rdfs:label>
        <rdfs:label xml:lang="de">hat Benachrichtigung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rescue-mate.de/ontology/hasNotificationTarget -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/hasNotificationTarget">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/NotificationEvent"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:comment xml:lang="en">A relation between a notification event and a role (capturing, e.g., a group of individuals). The message, i.e., the actual notification of the notification event addresses the group of individuals having the target role.</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine Relation zwischen einem Benachrichtigungsereignis und einer Rolle (die z.B. eine Gruppe von Individuen zusammenfasst). Die Benachrichtigung des Benachrichtigungsereignisses ist an die Gruppe der Individuen addressiert, die die addressierte Rolle inne haben.</rdfs:comment>
        <rdfs:label xml:lang="en">has notification target</rdfs:label>
        <rdfs:label xml:lang="de">hat Addressat für Benachrichtigung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rescue-mate.de/ontology/hasOperator -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/hasOperator">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/Facility"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/JuridicalPerson"/>
        <rdfs:label xml:lang="en">has operator</rdfs:label>
        <rdfs:label xml:lang="de">hat Betreiber</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rescue-mate.de/ontology/hasPosition -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/hasPosition">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/Position"/>
        <rdfs:comment xml:lang="de">Beziehung zwischen einem Objekt und einer Position (d.h. einem Raum-Zeit-Punkt)</rdfs:comment>
        <rdfs:comment xml:lang="en">Relation between an object and a position (being a point in space-time)</rdfs:comment>
        <rdfs:label xml:lang="en">has position</rdfs:label>
        <rdfs:label xml:lang="de">hat Position</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/hasPriority -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/hasPriority">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="en">has priority</rdfs:label>
        <rdfs:label xml:lang="de">hat Priorität</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/maximumOccupancy -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/maximumOccupancy">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="de">maximale Belegung</rdfs:label>
        <rdfs:label xml:lang="en">maximum occupancy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/Activity -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Activity">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:comment xml:lang="en">A process executed by an agent that has a certin outcome</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein Prozess, der von einem Agenten ausgeführt wird und ein bestimmtes Ergebnis hat</rdfs:comment>
        <rdfs:label xml:lang="en">Activity</rdfs:label>
        <rdfs:label xml:lang="de">Tätigkeit</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q1914636</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Agent -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Agent">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:comment xml:lang="en">An independent continuant that bears some form of responsibility for an activity taking place</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein independent continuant der eine gewisse Verantwortlichkeit in Bezug auf eine Aktivität hat</rdfs:comment>
        <rdfs:label xml:lang="de">Agent</rdfs:label>
        <rdfs:label xml:lang="en">Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Aircraft -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Aircraft">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Vehicle"/>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q11436</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Campaign -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Campaign">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/IntentionalHumanActivity"/>
        <rdfs:comment xml:lang="de">Abfolge von über einen definierten Zeitraum geplanten oder tatsächlich ausgeführten Aktionen die einem gemeinsamen Zweck dienen.</rdfs:comment>
        <rdfs:comment xml:lang="en">Series of actions planned for or executed during a defined time period that serve a common goal</rdfs:comment>
        <rdfs:label xml:lang="en">Campaign</rdfs:label>
        <rdfs:label xml:lang="de">Kampagne</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q6056746</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Change -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Change">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:comment xml:lang="en">Process, event or action that acts on the current state of something and generates a new state that deviates from the previous state</rdfs:comment>
        <rdfs:comment xml:lang="de">Prozess, Ereignis oder Handlung, die auf den Zustand von etwas einwirkt und einen neuen Zustand schafft, der von dem vorherigen Zustand abweicht</rdfs:comment>
        <rdfs:label xml:lang="en">Change</rdfs:label>
        <rdfs:label xml:lang="de">Veränderung</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q1150070</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Chat -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Chat">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">An activity involving agents sending and receiving messages and/or media content</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine Aktivität, bei der sich Agenten gegenseitig Nachrichten und/oder Medien senden und diese empfangen</rdfs:comment>
        <rdfs:label xml:lang="de">Chat</rdfs:label>
        <rdfs:label xml:lang="en">Chat</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/ChatImageMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/ChatImageMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/ChatMessage"/>
        <rdfs:label xml:lang="en">Chat image message</rdfs:label>
        <rdfs:label xml:lang="de">Chat-Bildnachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/ChatMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/ChatMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Message"/>
        <rdfs:label xml:lang="en">Chat message</rdfs:label>
        <rdfs:label xml:lang="de">Chat-Nachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/ChatTextMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/ChatTextMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/ChatMessage"/>
        <rdfs:label xml:lang="en">Chat text message</rdfs:label>
        <rdfs:label xml:lang="de">Chat-Textnachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/ChatVideoMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/ChatVideoMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/ChatMessage"/>
        <rdfs:label xml:lang="en">Chat video message</rdfs:label>
        <rdfs:label xml:lang="de">Chat-Videonachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Container -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Container">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:comment xml:lang="de">Großraum-Behälter zur Lagerung und zum Transport von Gütern</rdfs:comment>
        <rdfs:comment xml:lang="en">Large-capacity freight unit for the storage and transport of goods</rdfs:comment>
        <rdfs:label xml:lang="de">Container</rdfs:label>
        <rdfs:label xml:lang="en">Container</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/CrisisEvent -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/CrisisEvent">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:comment xml:lang="en">An occurrent descriping a crisis, i.e., an event potentially causing harm</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein Ereignis, das eine Krise beschreibt, d.h. ein Ereignis, das Schaden anrichten kann</rdfs:comment>
        <rdfs:label xml:lang="en">Crisis event</rdfs:label>
        <rdfs:label xml:lang="de">Krisenereignis</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/CrisisEventWithAffectedIndividuals -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/CrisisEventWithAffectedIndividuals">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/CrisisEvent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rescue-mate.de/ontology/CrisisEvent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A crisis event which has individuals (i.e. independent continuants) as participants that are impacted by the crisis&apos; outcome</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein Krisenereignis, an dem Individuen (d.h. bfo:IndipendentContinuants) beteiligt sind, die von den Auswirkungen des Krisenereignisses betroffen sind</rdfs:comment>
        <rdfs:label xml:lang="en">Crisis event with affected individuals</rdfs:label>
        <rdfs:label xml:lang="de">Krisenereignis mit betroffenen Individuen</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/CrisisMitigation -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/CrisisMitigation">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Mitigation"/>
        <rdfs:comment xml:lang="en">Process of reducting harm caused by a crisis</rdfs:comment>
        <rdfs:comment xml:lang="de">Vorgang der Verringerung von Schäden, die duch eine Krise entstanden sind</rdfs:comment>
        <rdfs:label xml:lang="en">Crisis mitigation</rdfs:label>
        <rdfs:label xml:lang="de">Schadensminderung in einer Krise</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Damage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Damage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Reduction"/>
        <rdfs:comment xml:lang="en">Changes to a system or object that adversely affect its current or future use or performance</rdfs:comment>
        <rdfs:comment xml:lang="de">Änderungen an einem System oder Objekt, die seine Nützlichkeit oder Leistungsfähigkeit negativ beeinträchtigen</rdfs:comment>
        <rdfs:label xml:lang="de">Beschädigung</rdfs:label>
        <rdfs:label xml:lang="en">Damage</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q481609</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Death -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Death">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Damage"/>
        <rdfs:comment xml:lang="en">A damage inflicted on living organisms causing permanent cessation of vital functions</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine Beschädigung die einem Lebewesen zugeführt wird und zum endgültigen Verlust iherer Lebensfunktionen führt</rdfs:comment>
        <rdfs:label xml:lang="en">Death</rdfs:label>
        <rdfs:label xml:lang="de">Tod</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q4</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DementiaCareLivingArea -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DementiaCareLivingArea">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Facility"/>
        <rdfs:comment xml:lang="de">Anlage für das betreute Wohnen von Demenzpatienten</rdfs:comment>
        <rdfs:comment xml:lang="en">Facility providing assisted living for dementia patients</rdfs:comment>
        <rdfs:label xml:lang="en">Dementia care living area</rdfs:label>
        <rdfs:label xml:lang="de">Wohnbereich Demenz</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DonationCampaign -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DonationCampaign">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Campaign"/>
        <rdfs:comment xml:lang="en">A campaign with the goal of collecting money or goods for a defined purpose</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine Kampagne mit dem Ziel Geld oder Güter für einen definierten Zweck zu sammeln</rdfs:comment>
        <rdfs:label xml:lang="en">Donation campaign</rdfs:label>
        <rdfs:label xml:lang="de">Spendenaktion</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DonationOrVolunteeringCampaign -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DonationOrVolunteeringCampaign">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rescue-mate.de/ontology/DonationCampaign"/>
                    <rdf:Description rdf:about="http://rescue-mate.de/ontology/VolunteeringCampaign"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Campaign"/>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Evacuation -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Evacuation">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:comment xml:lang="de">Bewegung von Lebewesen aus einem möglichen oder tatsächlichen Gefahrenbereich</rdfs:comment>
        <rdfs:comment xml:lang="en">Movement of living beings away from the threat of or the actual occurrence of a hazard</rdfs:comment>
        <rdfs:label xml:lang="en">Evacuation</rdfs:label>
        <rdfs:label xml:lang="de">Evakuierung</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q606332</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Facility -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Facility">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/GeographicEntity"/>
        <rdfs:comment xml:lang="en">Geographic entity that was created to support a specific function</rdfs:comment>
        <rdfs:comment xml:lang="de">Geographische Entität, die für einen bestimmten Zweck angelegt wurde</rdfs:comment>
        <rdfs:label xml:lang="de">Anlage</rdfs:label>
        <rdfs:label xml:lang="en">Facility</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q13226383</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Finding -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Finding">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:comment xml:lang="en">Recovery of the spatial reference of someone or something</rdfs:comment>
        <rdfs:comment xml:lang="de">Wiedererlangung des räumliche Bezugs zu jemanden oder etwas</rdfs:comment>
        <rdfs:label xml:lang="de">Finden</rdfs:label>
        <rdfs:label xml:lang="en">Finding</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q37112258</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/GeographicEntity -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/GeographicEntity">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:comment xml:lang="en">An object that is stationary, can be described and located at a geographical position</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein Objekt, das sich stationär an einer geographischen Position befindet, lokalisiert und beschrieben werden kann</rdfs:comment>
        <rdfs:label xml:lang="en">Geographic entity</rdfs:label>
        <rdfs:label xml:lang="de">Geographische Entität</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q27096213</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/GettingLost -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/GettingLost">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:comment xml:lang="en">Losing the spatial reference of someone or something</rdfs:comment>
        <rdfs:comment xml:lang="de">Verlust des räumlichen Bezugs zu jemanden oder etwas</rdfs:comment>
        <rdfs:label xml:lang="en">Getting lost</rdfs:label>
        <rdfs:label xml:lang="de">Verschwinden</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q23580581</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/GettingLostOrBeingFound -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/GettingLostOrBeingFound">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rescue-mate.de/ontology/Finding"/>
                    <rdf:Description rdf:about="http://rescue-mate.de/ontology/GettingLost"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/HumanActivity -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/HumanActivity">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Activity"/>
        <rdfs:comment xml:lang="en">An activity that is performed by a human being</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine Tätigkeit, die von einem Menschen ausgeführt wird</rdfs:comment>
        <rdfs:label xml:lang="en">Human activity</rdfs:label>
        <rdfs:label xml:lang="de">Menschliche Tätigkeit</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q61788060</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/HumanitarianActivity -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/HumanitarianActivity">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/IntentionalHumanActivity"/>
        <rdfs:comment xml:lang="en">An activity that is performed by a human being, driven by humanitarian motives, involving assistance to others and improvement of conditions for humanity</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine Tätigkeit, die von einem Menschen ausgeführt wird und von einem bewussten humanitären Ziel getrieben wird, insb. der Hilfe anderer und der Verbesserung von Lebensbedingungen von Menschen</rdfs:comment>
        <rdfs:label xml:lang="en">Humanitarian activity</rdfs:label>
        <rdfs:label xml:lang="de">Humanitäre Tätigkeit</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q107280686</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/InfrastructureDamage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/InfrastructureDamage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Damage"/>
        <rdfs:comment xml:lang="de">Beschädigung von Infrastruktur wie Straßen, Brücken, Gebäuden, Netzen für die Wasser- und Stromversorgung, oder Kommunikationsnetze</rdfs:comment>
        <rdfs:comment xml:lang="en">Damage of infrastructure elements like roads, bridges, buildings or utilities like water, electricity, and communication networks</rdfs:comment>
        <rdfs:label xml:lang="de">Beschädigung von Infrastruktur</rdfs:label>
        <rdfs:label xml:lang="en">Infrastructure damage</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Injury -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Injury">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Damage"/>
        <rdfs:comment xml:lang="en">A damage inflicted on living organisms impairing their physiological conditions</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine Beschädigung die einem Lebewesen zugeführt wird und deren körperliche Verfasssung negativ beeinträchtigt</rdfs:comment>
        <rdfs:label xml:lang="en">Injury</rdfs:label>
        <rdfs:label xml:lang="de">Verletzung</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/InjuryInHumanOrDeath -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/InjuryInHumanOrDeath">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rescue-mate.de/ontology/Death"/>
                    <rdf:Description rdf:about="http://rescue-mate.de/ontology/InjuryInHumans"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Damage"/>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/InjuryInHumans -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/InjuryInHumans">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Injury"/>
        <rdfs:comment xml:lang="en">A damage inflicted on living a human being impairing their physiological conditions</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine Beschädigung die einem Menschen zugeführt wird und dessen körperliche Verfasssung negativ beeinträchtigt</rdfs:comment>
        <rdfs:label xml:lang="en">Injury in humans</rdfs:label>
        <rdfs:label xml:lang="de">Verletzung beim Menschen</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q193078</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/IntentionalHumanActivity -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/IntentionalHumanActivity">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/HumanActivity"/>
        <rdfs:comment xml:lang="en">An activity that is performed by a human being, driven by purposeful motives</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine Tätigkeit, die von einem Menschen ausgeführt wird und von einer bewussten Motivation getrieben wird</rdfs:comment>
        <rdfs:label xml:lang="de">Intensionale menschliche Aktivität</rdfs:label>
        <rdfs:label xml:lang="en">Intentional human activity</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q451967</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/LKW -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/LKW">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/LandVehicle"/>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Vehicle"/>
        <rdfs:label xml:lang="de">Lastkraftwagen</rdfs:label>
        <rdfs:label xml:lang="en">Lorry</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/LandVehicle -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/LandVehicle">
