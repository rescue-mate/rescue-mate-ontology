        <rdfs:label xml:lang="de">Vollautomatische Drehleiter mit Korb 23/12</rdfs:label>
        <rdfs:label xml:lang="en">Vollautomatische Drehleiter mit Korb 23/12 (Germany)</rdfs:label>
    </owl:Class>
    


