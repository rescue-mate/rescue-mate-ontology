        <rdfs:comment xml:lang="en">Rüstwagen (Germany) that is bigger than a Rüstwagen 2 (Germany)</rdfs:comment>
        <rdfs:label xml:lang="de">Rüstwagen 3</rdfs:label>
        <rdfs:label xml:lang="en">Rüstwagen 3 (Germany)</rdfs:label>
    </owl:Class>
    


