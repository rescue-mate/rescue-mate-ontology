    <owl:Class rdf:about="http://rescue-mate.de/ontology/TLF16-24-Tr">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/TLF"/>
        <rdfs:comment xml:lang="en">Tanklöschfahrzeug (Germany) that can accommodate an independent crew</rdfs:comment>
        <rdfs:comment xml:lang="de">Tanklöschfahrzeug das einen selbstständigen Trupp aufnehmen kann</rdfs:comment>
        <rdfs:label xml:lang="de">Tanklöschfahrzeug 16/24 mit Truppbesatzung</rdfs:label>
        <rdfs:label xml:lang="en">Tanklöschfahrzeug 16/24 mit Truppbesatzung (Germany)</rdfs:label>
    </owl:Class>
    


