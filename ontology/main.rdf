        <rdfs:comment xml:lang="en">Larger rescue boat with motorization for use in flowing and open waters</rdfs:comment>
        <rdfs:label xml:lang="de">Rettungsboot Typ 2 (Feuerwehr)</rdfs:label>
        <rdfs:label xml:lang="en">Rettungsboot Typ 2 (Feuerwehr) (Germany)</rdfs:label>
    </owl:Class>
    


