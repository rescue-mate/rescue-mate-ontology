    </owl:DatatypeProperty>



    <!-- http://rescue-mate.de/ontology/numberOfCarSharingParkingSpaces -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/numberOfCarSharingParkingSpaces">
