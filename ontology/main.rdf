        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/DLS(K)"/>
        <rdfs:comment xml:lang="de">Sequentielle Drehleiter mit Korb und einer Nennrettungshöhe von 18 Metern bei 12 Metern Nennausladung</rdfs:comment>
