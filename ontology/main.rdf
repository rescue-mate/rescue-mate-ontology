        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/StLF"/>
        <rdfs:comment xml:lang="en">Staffellöschfahrzeug (Germany) with a fire-fighting centrifugal pump with a capacity of 2,000 liters of water per minute</rdfs:comment>
        <rdfs:comment xml:lang="de">Staffellöschfahrzeug mit einer Feuerlöschkreiselpumpe mit einer Förderleistung von 2.000 Liter Wasser in der Minute</rdfs:comment>
        <rdfs:label xml:lang="de">Staffellöschfahrzeug 20</rdfs:label>
