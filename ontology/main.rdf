        <rdfs:comment xml:lang="de">Kleinere Ausführung eines Schlauchwagens</rdfs:comment>
        <rdfs:comment xml:lang="en">Smaller version of a Schlauchwagen (Germany)</rdfs:comment>
        <rdfs:label xml:lang="de">Schlauchwagen 1000</rdfs:label>
        <rdfs:label xml:lang="en">Schlauchwagen 1000 (Germany)</rdfs:label>
    </owl:Class>
    


