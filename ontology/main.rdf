        <rdfs:comment xml:lang="en">Fire service trailer for the transport of fire hoses and accessories</rdfs:comment>
        <rdfs:label xml:lang="de">Schlauchtransportanhänger</rdfs:label>
        <rdfs:label xml:lang="en">Schlauchtransportanhänger (Germany)</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/SW -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/SW">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/FireFightingVehicle"/>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/LandVehicle"/>
        <rdfs:comment xml:lang="de">Feuerwehrfahrzeug für den Nachschub von Druckschläuchen und Armaturen sowie zum Verlegen von Druckschläuchen über lange Strecken</rdfs:comment>
        <rdfs:comment xml:lang="en">Fire-fighting vehicle for the supply of pressure hoses and fittings as well as for laying pressure hoses over long distances</rdfs:comment>
        <rdfs:label xml:lang="de">Schlauchwagen</rdfs:label>
        <rdfs:label xml:lang="en">Schlauchwagen (Germany)</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/SW-KatS -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/SW-KatS">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/SW"/>
        <rdfs:comment xml:lang="en">Schlauchwagen (Germany) equipped with a portable pump with a nominal flow rate of 1500 litres per minute at 10 bar nominal pressure, for use primarily in disaster control (especially in conjunction with the Löschgruppenfahrzeug 20 für den Katastrophenschutz (Germany))</rdfs:comment>
        <rdfs:comment xml:lang="de">Schlauchwagen mit einer Tragkraftspritze mit einer Nennförderleistung von 1500 Litern pro Minute bei 10 bar Nennförderdruck für den Einsatz, der vorrangig für den Katstrophenschutz eingesetzt wird (insb. in Verbindung mit dem Löschgruppenfahrzeug 20 für den Katastrophenschutz)</rdfs:comment>
        <rdfs:label xml:lang="de">Schlauchwagen für den Katastrophenschutz</rdfs:label>
        <rdfs:label xml:lang="en">Schlauchwagen für den Katastrophenschutz (Germany)</rdfs:label>
    </owl:Class>
    


