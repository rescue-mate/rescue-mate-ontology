        <rdfs:comment xml:lang="en">Small rescue boat with optional motorization for use in stagnant waters</rdfs:comment>
        <rdfs:label xml:lang="de">Rettungsboot Typ 1 (Feuerwehr)</rdfs:label>
        <rdfs:label xml:lang="en">Rettungsboot Typ 1 (Feuerwehr) (Germany)</rdfs:label>
    </owl:Class>
    


