    <!-- http://rescue-mate.de/ontology/clearWidthInMeters -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/clearWidthInMeters">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/HydraulicStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="de">Schartenbreite in Metern</rdfs:label>
        <rdfs:label xml:lang="en">clear width in meters</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/closedWaterLevelInMeters -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/closedWaterLevelInMeters">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/HydraulicStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="de">Schließwasserstand in Metern</rdfs:label>
        <rdfs:label xml:lang="en">closed water level in meters</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/dikeKilometer -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/dikeKilometer">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/DikeKilometerMarker"/>
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/FixedConstruction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="de">Deichkilometer</rdfs:label>
        <rdfs:label xml:lang="en">dike kilometer</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/dikeWardenID -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/dikeWardenID">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/DikeWarden"/>
        <rdfs:label xml:lang="de">Deichwart-ID</rdfs:label>
        <rdfs:label xml:lang="en">dike warden ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/fromDikeKilometer -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/fromDikeKilometer">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/HydraulicStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="de">Deichkilometer, an dem ein Wasserbauwerk beginnt</rdfs:comment>
        <rdfs:comment xml:lang="en">Dike kilometer at which a hydraulic structure begins</rdfs:comment>
        <rdfs:label xml:lang="en">from dike kilometer</rdfs:label>
        <rdfs:label xml:lang="de">von Deichkilometer</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/hasSillHeightInMetersAboveSeaLevel -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/hasSillHeightInMetersAboveSeaLevel">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/HydraulicStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="de">Drempelhöhe in Metern über Normalhöhennull</rdfs:label>
        <rdfs:label xml:lang="en">has sill height in meters above sea level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/openWaterLevelInMeters -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/openWaterLevelInMeters">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/HydraulicStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="de">Offenwasserstand in Metern</rdfs:label>
        <rdfs:label xml:lang="en">open water level in meters</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/protectsUpToHeightInMetersAboveSeaLevel -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/protectsUpToHeightInMetersAboveSeaLevel">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/HydraulicStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="de">Schutzhöhe in Metern über Normalhöhennull</rdfs:label>
        <rdfs:label xml:lang="en">protects up to height in meters above sea level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/secondDikeSafety -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/secondDikeSafety">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/HydraulicStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">second dike safety</rdfs:label>
        <rdfs:label xml:lang="de">zweite Deichsicherheit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/toDikeKilometer -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/toDikeKilometer">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/HydraulicStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="de">Deichkilometer, an dem ein Wasserbauwerk endet</rdfs:comment>
        <rdfs:comment xml:lang="en">Dike kilometer at which a hydraulic structure ends</rdfs:comment>
        <rdfs:label xml:lang="de">bis Deichkilometer</rdfs:label>
        <rdfs:label xml:lang="en">to dike kilometer</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/yearOfConstruction -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/yearOfConstruction">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/FixedConstruction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:label xml:lang="de">Baujahr</rdfs:label>
        <rdfs:label xml:lang="en">year of construction</rdfs:label>
    </owl:DatatypeProperty>
    


