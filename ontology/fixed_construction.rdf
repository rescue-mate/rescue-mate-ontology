        <owl:imports rdf:resource="http://rescue-mate.de/ontology/wikidata-bridge/0.6.0"/>
        <owl:imports rdf:resource="http://schemas.opengis.net/geosparql/1.0/geosparql_vocab_all.rdf"/>
        <owl:imports rdf:resource="http://www.opengis.net/ont/geosparql#1.1"/>
        <cc:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dct:contributor>Heiko Bornholdt</dct:contributor>
        <dct:created>2025-02-12</dct:created>
        <dct:creator>Patrick Westphal</dct:creator>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-07</dct:issued>
        <dct:modified>2025-11-07</dct:modified>
        <dct:rights xml:lang="en">CC BY 4.0 - RESCUE-MATE Project</dct:rights>
        <dct:title xml:lang="en">RESCUE-MATE Ontology Module for Fixed Constructions</dct:title>
        <dct:title xml:lang="de">RESCUE-MATE-Ontologie-Modul für Bauwerke</dct:title>
        <rdfs:comment xml:lang="de">Ontologie-Modul für Bauwerke zur Unterstützung der Datenintegration im RESCUE-MATE-Projekt</rdfs:comment>
        <rdfs:comment xml:lang="en">Ontology module covering fixed constructions to support the data integration part of the RESCUE-MATE project</rdfs:comment>
        <owl:priorVersion rdf:resource="http://rescue-mate.de/ontology/main/0.5.0"/>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</owl:versionInfo>
    </owl:Ontology>
    


