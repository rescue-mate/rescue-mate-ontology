        <rdfs:label xml:lang="en">Electric propulsion</rdfs:label>
        <rdfs:label xml:lang="de">Elektronischer Antrieb</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/ElectrohydraulicPropulsion -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/ElectrohydraulicPropulsion">
