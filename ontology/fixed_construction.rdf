        <rdfs:label xml:lang="de">Elektrohydraulischer Antrieb</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/FixedConstruction -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/FixedConstruction">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/GeographicEntity"/>
        <rdfs:label xml:lang="de">Bauwerk</rdfs:label>
        <rdfs:label xml:lang="en">Fixed construction</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.wikidata.org/wiki/Q811430"/>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/FloodGate -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/FloodGate">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/HydraulicStructure"/>
        <rdfs:label xml:lang="en">Flood gate</rdfs:label>
        <rdfs:label xml:lang="de">Flutschutztor</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.wikidata.org/wiki/Q2345125"/>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/FloodProtectionWall -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/FloodProtectionWall">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/HydraulicStructure"/>
        <rdfs:label xml:lang="en">Flood protection wall</rdfs:label>
        <rdfs:label xml:lang="de">Hochwasserschutzwand</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/GeographicEntity -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/GeographicEntity"/>
    


    <!-- http://rescue-mate.de/ontology/HingedCrestGate -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/HingedCrestGate">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/FloodGate"/>
        <rdfs:label xml:lang="en">Hinged crest gate</rdfs:label>
        <rdfs:label xml:lang="de">Klapptor</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/HydraulicCrossingStructure -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/HydraulicCrossingStructure">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/HydraulicStructure"/>
        <rdfs:label xml:lang="en">Hydraulic crossing structure</rdfs:label>
        <rdfs:label xml:lang="de">Kreuzungsbauwerk</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/HydraulicStructure -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/HydraulicStructure">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/FixedConstruction"/>
        <rdfs:label xml:lang="en">Hydraulic structure</rdfs:label>
        <rdfs:label xml:lang="de">Wasserbauwerk</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.wikidata.org/wiki/Q2466889"/>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/JuridicalPerson -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/JuridicalPerson">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:label xml:lang="en">Juridical person</rdfs:label>
        <rdfs:label xml:lang="de">Juristische Person</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.wikidata.org/wiki/Q155076"/>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Lock -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Lock">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/HydraulicStructure"/>
        <rdfs:label xml:lang="en">Lock</rdfs:label>
        <rdfs:label xml:lang="de">Schleuse</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.wikidata.org/wiki/Q105731"/>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/MainDikeLine -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/MainDikeLine">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="de">Abschnitt der durchgehenden Hauptdeichlinie. Instanzen sind die einzelnen kilometrierten Abschnitte, nicht die Linie als Ganzes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Section of the continuous main dike line. Instances are the individual chainaged sections, not the line as a whole.</rdfs:comment>
        <rdfs:label xml:lang="de">Hauptdeichlinie</rdfs:label>
        <rdfs:label xml:lang="en">Main dike line</rdfs:label>
    </owl:Class>
    


