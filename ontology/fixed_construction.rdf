    <!-- http://rescue-mate.de/ontology/DikeDefenseArea -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DikeDefenseArea">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
        <rdfs:label xml:lang="de">Deichverteidigungsgebiet</rdfs:label>
        <rdfs:label xml:lang="en">Dike defense area</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DikeDefenseSection -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DikeDefenseSection">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">A spatial region that marks a section of a dike a particular dike warden is responsible for</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein räumlicher Bereich, der den Abschnitt eines Deiches beschreibt, für den ein bestimmter Deichwart zuständig ist</rdfs:comment>
        <rdfs:label xml:lang="de">Deichverteidigungsabschnitt</rdfs:label>
        <rdfs:label xml:lang="en">Dike defense section</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DikeKilometerMarker -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DikeKilometerMarker">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">A geographic feature representing a chainage point along the main dike line</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein georgaphisches Feature, das einen Punkt der Kilometrierung entlang der Hauptdeichlinie beschreibt</rdfs:comment>
        <rdfs:label xml:lang="de">Deichkilometermarke</rdfs:label>
        <rdfs:label xml:lang="en">Dike kilometer marker</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DikeWarden -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DikeWarden">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:label xml:lang="de">Deichwart</rdfs:label>
        <rdfs:label xml:lang="en">Dike warden</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DischargeSluice -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DischargeSluice">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/HydraulicStructure"/>
        <rdfs:label xml:lang="de">Deichsiel</rdfs:label>
        <rdfs:label xml:lang="en">Discharge sluice</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.wikidata.org/wiki/Q510255"/>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/EarthDike -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/EarthDike">
