     -->

    


    <!-- http://rescue-mate.de/ontology/belongsToDikeDefenseArea -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/belongsToDikeDefenseArea">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/FixedConstruction"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/DikeDefenseArea"/>
        <rdfs:label xml:lang="en">belongs to dike defense area</rdfs:label>
        <rdfs:label xml:lang="de">gehört zu Deichverteidigungsgebiet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rescue-mate.de/ontology/belongsToSeniorDikeWardenDistrict -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/belongsToSeniorDikeWardenDistrict">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/DikeDefenseSection"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/SeniorDikeWardenDistrict"/>
        <rdfs:label xml:lang="en">belongs to senior dike warden district</rdfs:label>
        <rdfs:label xml:lang="de">gehört zu Oberdeichwart-Bezirk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rescue-mate.de/ontology/hasEndUserOrganization -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/hasEndUserOrganization">
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:label xml:lang="en">has end user organization</rdfs:label>
        <rdfs:label xml:lang="de">hat Bedarfsträger</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rescue-mate.de/ontology/hasImplementingAgency -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/hasImplementingAgency">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/FixedConstruction"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/JuridicalPerson"/>
        <rdfs:label xml:lang="en">has implementing agency</rdfs:label>
        <rdfs:label xml:lang="de">hat Realisierungsträger</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rescue-mate.de/ontology/maintenanceResponsibility -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/maintenanceResponsibility">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/FixedConstruction"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/JuridicalPerson"/>
        <rdfs:label xml:lang="de">Zuständigkeit Unterhaltung</rdfs:label>
        <rdfs:label xml:lang="en">maintenance responsibility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rescue-mate.de/ontology/responsibleDikeWarden -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/responsibleDikeWarden">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/FixedConstruction"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/DikeWarden"/>
        <rdfs:label xml:lang="en">responsible dike warden</rdfs:label>
        <rdfs:label xml:lang="de">zuständiger Deichwart</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rescue-mate.de/ontology/supervisoryResponsibility -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/supervisoryResponsibility">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/FixedConstruction"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/JuridicalPerson"/>
        <rdfs:label xml:lang="de">Zuständigkeit Aufsicht</rdfs:label>
        <rdfs:label xml:lang="en">supervisory responsibility</rdfs:label>
    </owl:ObjectProperty>
    


