<?xml version="1.0"?>
<rdf:RDF xmlns="http://rescue-mate.de/ontology/"
     xml:base="http://rescue-mate.de/ontology/"
     xmlns:cc="http://creativecommons.org/ns#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:dct="http://purl.org/dc/terms/"
     xmlns:fno="https://w3id.org/function/ontology#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:core="http://purl.org/vocab/frbr/core#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:schema="http://schema.org/"
     xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://rescue-mate.de/ontology/functions">
        <owl:versionIRI rdf:resource="http://rescue-mate.de/ontology/functions/0.6.0"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/bfo/2019-08-26/bfo.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/iao/2022-11-07/iao.owl"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/wikidata-bridge/0.6.0"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/fixed_construction/0.6.0"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/operational_resources/0.6.0"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov-o-inverses-20130430"/>
        <owl:imports rdf:resource="https://w3id.org/function/ontology/1.0.0"/>
        <cc:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dct:created>2025-02-12</dct:created>
        <dct:creator>Patrick Westphal</dct:creator>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-07</dct:issued>
        <dct:modified>2025-11-07</dct:modified>
        <dct:rights xml:lang="en">CC BY 4.0 - RESCUE-MATE Project</dct:rights>
        <dct:title xml:lang="en">RESCUE-MATE Ontology</dct:title>
        <dct:title xml:lang="de">RESCUE-MATE-Ontologie</dct:title>
        <rdfs:comment xml:lang="de">Ontologie-Modul für benutzerdefinierte RML-Funktionen und ihre Parameter zur Unterstützung der Datenintegration im RESCUE-MATE-Projekt</rdfs:comment>
        <rdfs:comment xml:lang="en">Ontology module for custom RML functions and parameters to support the data integration part of the RESCUE-MATE project</rdfs:comment>
        <owl:priorVersion rdf:resource="http://rescue-mate.de/ontology/main/0.5.0"/>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</owl:versionInfo>
    </owl:Ontology>
    

    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://creativecommons.org/ns#license -->

    <owl:AnnotationProperty rdf:about="http://creativecommons.org/ns#license"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/issued -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/rights -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/rights"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/split -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/ontology/split">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die einen Eingabe-String entgegen nimmt und ihn n mal an Leerzeichen splittet (wobei n ein Eingabeparameter ist), und den i-ten Teil zurück gibt (wobei i ein weiterer Eingabeparameter ist und 0 den ersten Teilstring addressiert).</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes an input sting, splits it on white spaces n times (where n is a call parameter), and returns the i-th part (where i is another call parameter and 0 refers to the first part).</rdfs:comment>
        <rdfs:label xml:lang="en">Split</rdfs:label>
        <rdfs:label xml:lang="de">Splitte auf</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/areaName -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/areaName">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:label xml:lang="en">Area name</rdfs:label>
        <rdfs:label xml:lang="de">Gebietsname</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/base64String -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/base64String">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:comment xml:lang="en">String containing content encoded in the base64 format</rdfs:comment>
        <rdfs:comment xml:lang="de">String, mit base6-encodierten Inhalt</rdfs:comment>
        <rdfs:label xml:lang="en">Base-64 string</rdfs:label>
        <rdfs:label xml:lang="de">Base-64-String</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/classIRI -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/classIRI">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:label xml:lang="en">Class IRI</rdfs:label>
        <rdfs:label xml:lang="de">Klassen-IRI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/csvString -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/csvString">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:comment xml:lang="en">String containing multiple values, separated by commas</rdfs:comment>
        <rdfs:comment xml:lang="de">String, der mehrere Werte enthält, die durch Kommas abgetrennt sind</rdfs:comment>
        <rdfs:label xml:lang="en">CSV string</rdfs:label>
        <rdfs:label xml:lang="de">CSV-String</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/dateTimeStampString -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/dateTimeStampString">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:comment xml:lang="de">Date-Time-Stamp-String mit oder ohne Zeitzoneninformation</rdfs:comment>
        <rdfs:comment xml:lang="en">Date-time stamp string with or without time zone information</rdfs:comment>
        <rdfs:label xml:lang="de">Date-Time-Stamp-String</rdfs:label>
        <rdfs:label xml:lang="en">Date-time stamp string</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/downloadFileAndReturnRMURL -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/downloadFileAndReturnRMURL">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion die eine Datei von einem gegebenen URL herunterlädt, sie in der RESCUE-MATE-Datenplattform speichert und einen plattforminternen URL zurückgibt, unter dem die Datei über die RESCUE-MATE-Datenplattform zu erreichen ist</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that downloads a file from a given URL, stores it in the RESCUE-MATE data platform, and returns the URL where to access it via the RESCUE-MATE data platform.</rdfs:comment>
        <rdfs:label xml:lang="de">Datei herunterladen und RESCUE-MATE-URL zurückgeben</rdfs:label>
        <rdfs:label xml:lang="en">Download file and return RESCUE-MATE URL</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/eMailAddressString -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/eMailAddressString">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:comment xml:lang="en">String containing an e-mail address</rdfs:comment>
        <rdfs:comment xml:lang="de">String, der eine E-Mail-Adresse enthält</rdfs:comment>
        <rdfs:label xml:lang="de">E-Mail-Adress-String</rdfs:label>
        <rdfs:label xml:lang="en">E-mail address string</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/eventCategory -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/eventCategory">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:comment xml:lang="en">A string containing an ID for a event category</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein String, der die ID einer Ereigniskategorie enthält</rdfs:comment>
        <rdfs:label xml:lang="de">Ereigniskategorie</rdfs:label>
        <rdfs:label xml:lang="en">Event category</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/fixedConstructionTypeName -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/fixedConstructionTypeName">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:comment xml:lang="en">String containing the fixed construction type</rdfs:comment>
        <rdfs:comment xml:lang="de">String, der den Namen eines Bauwerkstyps enthält</rdfs:comment>
        <rdfs:label xml:lang="de">Bauwerkstypname</rdfs:label>
        <rdfs:label xml:lang="en">Fixed construction type name</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/generateRandomResourceIRI -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/generateRandomResourceIRI">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine zufällige IRI im RESCUE-MATE &quot;resource&quot;-Namensraum generiert.</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that generates a random IRI in the RESCUE-MATE resource namespace.</rdfs:comment>
        <rdfs:label xml:lang="de">Erstelle zufällige Ressourcen-IRI</rdfs:label>
        <rdfs:label xml:lang="en">Generate random resource IRI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/generateResourceIRI -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/generateResourceIRI">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine IRI im RESCUE-MATE-Ressourcen-Namensraum für eine ID oder einen Namen generiert</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that generates a proper IRI in the RESCUE-MATE resource namespace for an input ID string</rdfs:comment>
        <rdfs:label xml:lang="en">Generate resource IRI</rdfs:label>
        <rdfs:label xml:lang="de">Name zu Ressourcen-IRI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTLineString -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTLineString">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine Liste von Punkt-Repräsentationen einer GeoJSON-Datei entgegennimmt und einen WKT-Line-String zurückgibt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a list of point strings as input and returns a WKT string for the line string geometry represented by the input GeoJSON data</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT line string</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu WKT-Linienzug</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTMultiLineString -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTMultiLineString">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine Liste von Linienzügen aus einer GeoJSON-Datei entgegennimmt und einen WKT-Multi-Line-String zurückgibt</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a list of line strings as input and returns a WKT string for the multi line string geometry represented by the input GeoJSON data</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT Multi-Line String</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu Multi-Linienzug</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTMultiPoint -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTMultiPoint">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine Liste mit GeoJSON-Punkt-Repräsentationen entgegennimmt und einen Multi-Punkt-WKT-String zurückgibt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a list of point strings as input and returns a WKT string for the multi-point geometry represented by the input GeoJSON data.</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT multi-point</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu WKT Multi-Punkt</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTMultiPolygon -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTMultiPolygon">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion die eine Liste von GeoJSON-String-Representationen von Polygonen entgegennimmt und eine WKT-String-Repräsentation eines Multipolygons der Eingabedaten zurückgibt</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a list of string representations of GeoJSON polygons as input and returns a WKT string of the multi-polygon geometry represented by the input GeoJSON data</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT multi-polygon</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu WKT Multi-Polygon</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTPoint -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTPoint">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine Liste mit (normalerweise) einer String-Repräsentaion eines Punktes entgegennimmt und einen WKT-String für den Punkt zurückgibt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a (singleton) list of point strings as input and returns a WKT string for the point geometry represented by the GeoJSON data</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT point</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu WKT-Punkt</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTPolygon -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTPolygon">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine Liste mit einer GeoJSON-String-Repräsentationen von einem Polygonen entgegennimmt und eine WKT-String-Repräsentation des Polygons zurückgibt</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a singleton list of string representations of GeoJSON polygons as input and returns a WKT string of the polygon geometry represented by the input GeoJSON data</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT polygon</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu WKT-Polygon</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTString -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTString">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die einen Geometrietyp und eine Liste mit GeoJSON-Geometrie-Strings entgegennimmt und einen WKT-String der Geometrien zurückgibt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a geometry type and a list of string representations of GeoJSON geometries and returns a WKT string representation of the geometries</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT string</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu WKT-String</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geometryData -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geometryData">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:comment xml:lang="en">List of strings representing geometries</rdfs:comment>
        <rdfs:comment xml:lang="de">Liste von Strings die Geometrien representieren</rdfs:comment>
        <rdfs:label xml:lang="de">Geometriedaten</rdfs:label>
        <rdfs:label xml:lang="en">Geometry data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geometryType -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geometryType">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:comment xml:lang="en">A string indicating the geometry type (point, multi-point, line string, multi-line string, polygon, multi-polygon)</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein String, der einen Geometrietyp bestimmt (Punkt, Multi-Punkt, Linienzug, Multi-Linienzug, Polygon, Multi-Polygon)</rdfs:comment>
        <rdfs:label xml:lang="de">Geometrietyp</rdfs:label>
        <rdfs:label xml:lang="en">Geometry type</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/getDikeDefenseArea -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/getDikeDefenseArea">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die die IRI eines Deichverteidigungsgebiets zurückgibt</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that returns the proper IRI of a dike defense area referred to by name.</rdfs:comment>
        <rdfs:label xml:lang="de">Deichverteidigungsgebiet von Gebietsname</rdfs:label>
        <rdfs:label xml:lang="en">Get dike defense area</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/getEMailAddressIRI -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/getEMailAddressIRI">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die für eine Eingabe-E-Mail-Adresse eine vollstandige IRI zurückgibt, sofern die E-Mail-Adresse nicht leer ist</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that returns a proper IRI for an input e-mail address string if it is not empty</rdfs:comment>
        <rdfs:label xml:lang="de">E-Mail-Adresse zu E-Mail-Adress-IRI</rdfs:label>
        <rdfs:label xml:lang="en">Get e-mail address IRI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/getEmergencyVehicleStatus -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/getEmergencyVehicleStatus">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die für ein Eingabe-Fahrzeugtyp und einen FMS-Code die IRI der Zusatndsklasse des Fahrzeugs zurückgibt</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that returns the state concept IRI given an FMS state code and a vehicle class</rdfs:comment>
        <rdfs:label xml:lang="de">FMS-Code zu Fahrzeugstatus</rdfs:label>
        <rdfs:label xml:lang="en">Get emergency vehicle status</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/getEventCategoryClass -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/getEventCategoryClass">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="en">Custom RML function that returns the class IRI for an event category referred to by an ID string given as input to the function</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine benutzerdefinierte RML-Funktion die die IRI für eine Eingabe-Ereigniskategorie-ID zurückgibt</rdfs:comment>
        <rdfs:label xml:lang="de">Ereigniskategorie-Klasse von Ereigniskategoie-ID</rdfs:label>
        <rdfs:label xml:lang="en">Get event category class</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/getFacilityTypeIRIs -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/getFacilityTypeIRIs">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die für einen Eingabe-String mit komma-separierten Einrichtungstypen eine Liste von Einrichtungstyp-IRIs zurück gibt</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that returns class IRIs for a comma-separated values input string with facility type names</rdfs:comment>
        <rdfs:label xml:lang="de">Einrichtungstyp-IRIs für Einrichtungstypenliste</rdfs:label>
        <rdfs:label xml:lang="en">Get facility type IRIs</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/getFixedConstructionType -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/getFixedConstructionType">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Funktion, die für einen Bauwerktypnamen eine Typ-IRI zurückgibt</rdfs:comment>
        <rdfs:comment xml:lang="en">Given a type name as input this function returns the proper IRI of a fixed construction type</rdfs:comment>
