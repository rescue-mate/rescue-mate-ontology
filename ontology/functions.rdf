        <rdfs:label xml:lang="en">Class IRI</rdfs:label>
        <rdfs:label xml:lang="de">Klassen-IRI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/csvString -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/csvString">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:comment xml:lang="en">String containing multiple values, separated by commas</rdfs:comment>
        <rdfs:comment xml:lang="de">String, der mehrere Werte enthält, die durch Kommas abgetrennt sind</rdfs:comment>
        <rdfs:label xml:lang="en">CSV string</rdfs:label>
        <rdfs:label xml:lang="de">CSV-String</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/dateTimeStampString -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/dateTimeStampString">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:comment xml:lang="de">Date-Time-Stamp-String mit oder ohne Zeitzoneninformation</rdfs:comment>
        <rdfs:comment xml:lang="en">Date-time stamp string with or without time zone information</rdfs:comment>
        <rdfs:label xml:lang="de">Date-Time-Stamp-String</rdfs:label>
        <rdfs:label xml:lang="en">Date-time stamp string</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/downloadFileAndReturnRMURL -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/downloadFileAndReturnRMURL">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion die eine Datei von einem gegebenen URL herunterlädt, sie in der RESCUE-MATE-Datenplattform speichert und einen plattforminternen URL zurückgibt, unter dem die Datei über die RESCUE-MATE-Datenplattform zu erreichen ist</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that downloads a file from a given URL, stores it in the RESCUE-MATE data platform, and returns the URL where to access it via the RESCUE-MATE data platform.</rdfs:comment>
        <rdfs:label xml:lang="de">Datei herunterladen und RESCUE-MATE-URL zurückgeben</rdfs:label>
        <rdfs:label xml:lang="en">Download file and return RESCUE-MATE URL</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/eMailAddressString -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/eMailAddressString">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:comment xml:lang="en">String containing an e-mail address</rdfs:comment>
        <rdfs:comment xml:lang="de">String, der eine E-Mail-Adresse enthält</rdfs:comment>
        <rdfs:label xml:lang="de">E-Mail-Adress-String</rdfs:label>
        <rdfs:label xml:lang="en">E-mail address string</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/eventCategory -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/eventCategory">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:comment xml:lang="en">A string containing an ID for a event category</rdfs:comment>
        <rdfs:comment xml:lang="de">Ein String, der die ID einer Ereigniskategorie enthält</rdfs:comment>
        <rdfs:label xml:lang="de">Ereigniskategorie</rdfs:label>
        <rdfs:label xml:lang="en">Event category</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/fixedConstructionTypeName -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/fixedConstructionTypeName">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Parameter"/>
        <rdfs:comment xml:lang="en">String containing the fixed construction type</rdfs:comment>
        <rdfs:comment xml:lang="de">String, der den Namen eines Bauwerkstyps enthält</rdfs:comment>
        <rdfs:label xml:lang="de">Bauwerkstypname</rdfs:label>
        <rdfs:label xml:lang="en">Fixed construction type name</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/generateRandomResourceIRI -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/generateRandomResourceIRI">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine zufällige IRI im RESCUE-MATE &quot;resource&quot;-Namensraum generiert.</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that generates a random IRI in the RESCUE-MATE resource namespace.</rdfs:comment>
        <rdfs:label xml:lang="de">Erstelle zufällige Ressourcen-IRI</rdfs:label>
        <rdfs:label xml:lang="en">Generate random resource IRI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/generateResourceIRI -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/generateResourceIRI">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine IRI im RESCUE-MATE-Ressourcen-Namensraum für eine ID oder einen Namen generiert</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that generates a proper IRI in the RESCUE-MATE resource namespace for an input ID string</rdfs:comment>
        <rdfs:label xml:lang="en">Generate resource IRI</rdfs:label>
        <rdfs:label xml:lang="de">Name zu Ressourcen-IRI</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTLineString -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTLineString">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine Liste von Punkt-Repräsentationen einer GeoJSON-Datei entgegennimmt und einen WKT-Line-String zurückgibt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a list of point strings as input and returns a WKT string for the line string geometry represented by the input GeoJSON data</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT line string</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu WKT-Linienzug</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTMultiLineString -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTMultiLineString">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine Liste von Linienzügen aus einer GeoJSON-Datei entgegennimmt und einen WKT-Multi-Line-String zurückgibt</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a list of line strings as input and returns a WKT string for the multi line string geometry represented by the input GeoJSON data</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT Multi-Line String</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu Multi-Linienzug</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTMultiPoint -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTMultiPoint">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine Liste mit GeoJSON-Punkt-Repräsentationen entgegennimmt und einen Multi-Punkt-WKT-String zurückgibt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a list of point strings as input and returns a WKT string for the multi-point geometry represented by the input GeoJSON data.</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT multi-point</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu WKT Multi-Punkt</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTMultiPolygon -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTMultiPolygon">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion die eine Liste von GeoJSON-String-Representationen von Polygonen entgegennimmt und eine WKT-String-Repräsentation eines Multipolygons der Eingabedaten zurückgibt</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a list of string representations of GeoJSON polygons as input and returns a WKT string of the multi-polygon geometry represented by the input GeoJSON data</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT multi-polygon</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu WKT Multi-Polygon</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTPoint -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTPoint">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine Liste mit (normalerweise) einer String-Repräsentaion eines Punktes entgegennimmt und einen WKT-String für den Punkt zurückgibt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a (singleton) list of point strings as input and returns a WKT string for the point geometry represented by the GeoJSON data</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT point</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu WKT-Punkt</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTPolygon -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTPolygon">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die eine Liste mit einer GeoJSON-String-Repräsentationen von einem Polygonen entgegennimmt und eine WKT-String-Repräsentation des Polygons zurückgibt</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a singleton list of string representations of GeoJSON polygons as input and returns a WKT string of the polygon geometry represented by the input GeoJSON data</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT polygon</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu WKT-Polygon</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://rescue-mate.de/resource/geoJSONToWKTString -->

    <owl:NamedIndividual rdf:about="http://rescue-mate.de/resource/geoJSONToWKTString">
        <rdf:type rdf:resource="https://w3id.org/function/ontology#Function"/>
        <rdfs:comment xml:lang="de">Benutzerdefinierte RML-Funktion, die einen Geometrietyp und eine Liste mit GeoJSON-Geometrie-Strings entgegennimmt und einen WKT-String der Geometrien zurückgibt.</rdfs:comment>
        <rdfs:comment xml:lang="en">Custom RML function that takes a geometry type and a list of string representations of GeoJSON geometries and returns a WKT string representation of the geometries</rdfs:comment>
        <rdfs:label xml:lang="en">GeoJSON to WKT string</rdfs:label>
        <rdfs:label xml:lang="de">GeoJSON zu WKT-String</rdfs:label>
    </owl:NamedIndividual>
