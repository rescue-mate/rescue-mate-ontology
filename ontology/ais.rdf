<?xml version="1.0"?>
<rdf:RDF xmlns="http://rescue-mate.de/ontology/"
     xml:base="http://rescue-mate.de/ontology/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:qudt="http://qudt.org/schema/qudt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vaem="http://www.linkedmodel.org/schema/vaem#"
     xmlns:dtype="http://www.linkedmodel.org/schema/dtype#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:ontology="http://rescue-mate.de/ontology/">
    <owl:Ontology rdf:about="http://rescue-mate.de/ontology/ais">
        <owl:versionIRI rdf:resource="http://rescue-mate.de/ontology/ais/0.6.0"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/bfo/2019-08-26/bfo.owl"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/main/0.6.0"/>
        <owl:imports rdf:resource="https://burbachs.github.io/AISHIPOntology/AISHIP"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/aisVersion -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/aisVersion">
        <rdfs:comment xml:lang="de">Die Version der AIS-Spezifikation, die zur Beschreibung einer AIS-Nachricht verwendet wird</rdfs:comment>
        <rdfs:comment xml:lang="en">The AIS specification version used to describe an AIS message</rdfs:comment>
        <rdfs:label xml:lang="en">AIS version</rdfs:label>
        <rdfs:label xml:lang="de">AIS-Version</rdfs:label>
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/capturedByElectronicPositionFixingDevice -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/capturedByElectronicPositionFixingDevice">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/Position"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/ElectronicPositionFixingDevice"/>
        <rdfs:label xml:lang="en">captured by electronic position fixing device</rdfs:label>
        <rdfs:label xml:lang="de">erfasst von elektronischem Gerät zur Standortbestimmung</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/aisMessageType -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/aisMessageType">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Assigns the integer number representing the AIS message type (e.g. 24 for rmo:Resource StaticDataReportMessage) to an AIS message</rdfs:comment>
        <rdfs:comment xml:lang="de">Weist einer AIS-Nachricht die Nummer des AIS-Nachrichtentyps zu (z.B. 24 für den Typ rmo:Resource StaticDataReportMessage)</rdfs:comment>
        <rdfs:label xml:lang="en">AIS message type</rdfs:label>
        <rdfs:label xml:lang="de">AIS-Nachrichtentyp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/aisShipTypeCode -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/aisShipTypeCode">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/Watercraft"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="de">AIS Schiffstyp-Code</rdfs:label>
        <rdfs:label xml:lang="en">AIS ship type code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/courseOverGroundAtPosition -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/courseOverGroundAtPosition">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/Position"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label xml:lang="de">Kurs über Grund an Position</rdfs:label>
        <rdfs:label xml:lang="en">course over ground at position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/estimatedTimeOfArrival -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/estimatedTimeOfArrival">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/Vehicle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <obo:IAO_0000116 xml:lang="en">Maybe the domain get be set to something more general than rmo:Vehicle</obo:IAO_0000116>
        <rdfs:label xml:lang="en">estimated time of arrival</rdfs:label>
        <rdfs:label xml:lang="de">geschätzte Ankunftszeit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/headingAtPositionInDegrees -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/headingAtPositionInDegrees">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/Position"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="de">Richtung in Grand an Position</rdfs:label>
        <rdfs:label xml:lang="en">heading at position in degrees</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/highPositionAccuracy -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/highPositionAccuracy">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/Position"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">high position accuracy</rdfs:label>
        <rdfs:label xml:lang="de">hohe Positionsgenauigkeit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/positionIndex -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/positionIndex">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:label xml:lang="de">Positionsindex</rdfs:label>
        <rdfs:label xml:lang="en">position index</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/rateOfTurn -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/rateOfTurn">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/Watercraft"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Indicates how quickly the vessel is turning. A negative value indicates a port turn, a positive value indicates turning starboard.</rdfs:comment>
        <rdfs:comment xml:lang="de">Zeigt an, wie schnell ein Schiff dreht. Ein negativer Wert bedeutet eine Drehung nach Backbord, ein positiver Wert eine Drehung nach Steuerbord.</rdfs:comment>
        <rdfs:label xml:lang="de">Drehrate</rdfs:label>
        <rdfs:label xml:lang="en">rate of turn</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/receivedAt -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/receivedAt">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/Message"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="de">empfangen am</rdfs:label>
        <rdfs:label xml:lang="en">received at</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/specialManoeuvreIsPerformedAtPosition -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/specialManoeuvreIsPerformedAtPosition">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/Position"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="de">Speizialmanöver wird an Position durchgeführt</rdfs:label>
        <rdfs:label xml:lang="en">special manoeuvre is performed at position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rescue-mate.de/ontology/speedOverGroundAtPosition -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/speedOverGroundAtPosition">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/Position"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label xml:lang="de">Geschwindigkeit über Grund an Position</rdfs:label>
        <rdfs:label xml:lang="en">speed over ground at position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/AISMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AISMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Message"/>
        <rdfs:comment xml:lang="en">A message sent or received via the automatic identification system (AIS)</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine Nachricht, die über das Automatic Identification System (AIS) empfangen oder gesendet wurde</rdfs:comment>
        <rdfs:label xml:lang="en">AIS message</rdfs:label>
        <rdfs:label>AIS-Nachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AddressedSafetyRelatedMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AddressedSafetyRelatedMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is used to send text messages to a specified vessel</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die verwendet wird, um Textnachrichten an ein bestimmtes Wasserfahrzeug zu senden</rdfs:comment>
        <rdfs:label xml:lang="en">Addressed safety-related message</rdfs:label>
        <rdfs:label xml:lang="de">addressierte, sicherheitsbezogene Nachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AidsToNavigationReportMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AidsToNavigationReportMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message used by an (AtN) aid to navigation device</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die von einem Navigationsunterstützungsgerät verwendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">Aids-to-navigation report message</rdfs:label>
        <rdfs:label xml:lang="de">Nachricht zur Navigationsunterstützung</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AssignedModeCommandMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AssignedModeCommandMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is used by base stations to assign a specific report bahavior</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht die von Basisstationen genutzt wird, um anderen AIS-Geräten bestimmte Meldeverhalten zuzuweisen</rdfs:comment>
        <rdfs:label xml:lang="en">Assigned mode command message</rdfs:label>
        <rdfs:label xml:lang="de">Nachricht zur Zuweisung eines Modus</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/BaseStationReportMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/BaseStationReportMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message sent by base stations to indicate their presence</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die von Basisstationen versendet wird, um deren Anwesenheit anzuzeigen</rdfs:comment>
        <rdfs:label xml:lang="en">Base station report message</rdfs:label>
        <rdfs:label xml:lang="de">Basisstationsreportnachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/BinaryAcknowledgeMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/BinaryAcknowledgeMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is sent to acknowledge the reception of a binary addressed message</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die als Empfangsbestätigung auf eine adressierte Binärnachricht gesendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">Binary acknowledge message</rdfs:label>
        <rdfs:label xml:lang="de">binäre Bestätigungsnachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/BinaryAddressedMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/BinaryAddressedMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is addressed point-to-point with unspecified binary payload</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die punkt-zu-punkt-adressiert ist und nicht näher spezifizierten Binär-Inhalt hat</rdfs:comment>
        <rdfs:label xml:lang="en">Binary addressed message</rdfs:label>
        <rdfs:label xml:lang="de">addressierte Binärnachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/BinaryBroadcastMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/BinaryBroadcastMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS-message with unspecified binary payload that is broadcast</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht mit nicht näher spezifiziertem binären Inhalt, die als Broadcast versendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">Binary broadcast message</rdfs:label>
        <rdfs:label xml:lang="de">binäre Broadcast-Nachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/ChannelManagementMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/ChannelManagementMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message sent by a base station to manage channels and transceiver modes</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die von einer Basisstation zur Verwaltung von Funkkanälen und Transceiver-Modi gesendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">Channel management message</rdfs:label>
        <rdfs:label xml:lang="de">Funkkanalverwaltungsnachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/ChaykaDevice -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/ChaykaDevice">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/ElectronicPositionFixingDevice"/>
        <rdfs:label xml:lang="de">Chayka-Gerät</rdfs:label>
        <rdfs:label xml:lang="en">ChaykaDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/CombinedGPSAndGLONASSDevice -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/CombinedGPSAndGLONASSDevice">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/ElectronicPositionFixingDevice"/>
        <rdfs:label xml:lang="en">Combined GPS and GLONASS device</rdfs:label>
        <rdfs:label xml:lang="de">kombiniertes GPS- und GLONASS-Gerät</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DataLinkManagementMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DataLinkManagementMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message used by a base station to manage the AIS slots</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die von Basisstationen zur Verwaltung von AIS-Zeitschlitzen verwendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">Data link management message</rdfs:label>
        <rdfs:label xml:lang="de">Nachricht zur Verwaltung von Datenverbindungen</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/ElectronicPositionFixingDevice -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/ElectronicPositionFixingDevice">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:label xml:lang="en">Electronic position fixing device</rdfs:label>
        <rdfs:label xml:lang="de">elektronisches Gerät zur Standordbestimmung</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/ExtendedClassBEquipmentPositionReportMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/ExtendedClassBEquipmentPositionReportMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message used for position reports of class B legacy equipment</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht für Positionsreports von veralteter Ausrüstung der Klasse B</rdfs:comment>
        <rdfs:label xml:lang="en">Extended class B equipment position report message</rdfs:label>
        <rdfs:label xml:lang="de">Nachricht für erweiterte Positionsreports von Ausrüstung der Klasse B</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/GLONASSDevice -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/GLONASSDevice">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/ElectronicPositionFixingDevice"/>
        <rdfs:label xml:lang="en">GLONASS device</rdfs:label>
        <rdfs:label xml:lang="de">GLONASS-Gerät</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/GPSDevice -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/GPSDevice">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/ElectronicPositionFixingDevice"/>
        <rdfs:label xml:lang="en">GPS device</rdfs:label>
        <rdfs:label xml:lang="de">GPS-Gerät</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/GalileoDevice -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/GalileoDevice">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/ElectronicPositionFixingDevice"/>
        <rdfs:label xml:lang="en">Galileo device</rdfs:label>
        <rdfs:label xml:lang="de">Galileo-Gerät</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/GlobalNavigationSatelliteSystemBroadcastBinaryMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/GlobalNavigationSatelliteSystemBroadcastBinaryMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is sent by a base station to broadcast differential corrections for GPS</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die von Basisstationen zur differentiellen Korrektur des Global Positioning System versendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">Global navigation satellite system broadcast binary message</rdfs:label>
        <rdfs:label xml:lang="de">Navigationssatelliten-Binär-Broadcast-Nachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/GroupAssignmentCommandMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/GroupAssignmentCommandMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message sent by a base station to assign a specific report behaviour to a specific group of mobiles</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die von Basisstationen gesendet wird, um einer Gruppe von mobilen Endgeräten ein bestimmtes Reportverhalten zuzuweisen</rdfs:comment>
        <rdfs:label xml:lang="en">Group assignment command message</rdfs:label>
        <rdfs:label xml:lang="de">Gruppenzuweisungsnachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/IntegratedNavigationSystem -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/IntegratedNavigationSystem">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/ElectronicPositionFixingDevice"/>
        <rdfs:label xml:lang="en">Integrated navigation system</rdfs:label>
        <rdfs:label xml:lang="de">integriertes Navigationssystem</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/InterrogationMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/InterrogationMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is used by a base station to get the status of up to two other AIS devices</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die von eine Basisstation zur Statusabfrage von bis zu zwei weiteren AIS-Geräten verwendet wird</rdfs:comment>
        <rdfs:label xml:lang="de">Abfragenachricht</rdfs:label>
        <rdfs:label xml:lang="en">Interrogation message</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/LongRangeAutomaticIdentificationSystemBroadcastMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/LongRangeAutomaticIdentificationSystemBroadcastMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is used for long-range detection of AIS Class A and Class B vessels (typically by satellite)</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die zum Auffinden von Wasserfahrzeugen mit Transceivern der Klassen A und B verwendet wird</rdfs:comment>
        <rdfs:label xml:lang="de">Broadcast-Nachricht für weiträumliches automatisches Identifikationssystem</rdfs:label>
        <rdfs:label xml:lang="en">Long-range automatic identification system broadcast message</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/LoranCDevice -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/LoranCDevice">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/ElectronicPositionFixingDevice"/>
        <rdfs:label xml:lang="en">Loran-C device</rdfs:label>
        <rdfs:label xml:lang="de">Loran-C-Gerät</rdfs:label>
