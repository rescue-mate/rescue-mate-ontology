<?xml version="1.0"?>
<rdf:RDF xmlns="http://rescue-mate.de/ontology/"
     xml:base="http://rescue-mate.de/ontology/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:qudt="http://qudt.org/schema/qudt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vaem="http://www.linkedmodel.org/schema/vaem#"
     xmlns:dtype="http://www.linkedmodel.org/schema/dtype#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:ontology="http://rescue-mate.de/ontology/">
    <owl:Ontology rdf:about="http://rescue-mate.de/ontology/ais">
        <owl:versionIRI rdf:resource="http://rescue-mate.de/ontology/ais/0.6.0"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/bfo/2019-08-26/bfo.owl"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/main/0.6.0"/>
        <owl:imports rdf:resource="https://burbachs.github.io/AISHIPOntology/AISHIP"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/AISMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AISMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Message"/>
        <rdfs:comment xml:lang="en">A message sent or received via the automatic identification system (AIS)</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine Nachricht, die über das Automatic Identification System (AIS) empfangen oder gesendet wurde</rdfs:comment>
        <rdfs:label xml:lang="en">AIS message</rdfs:label>
        <rdfs:label>AIS-Nachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AddressedSafetyRelatedMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AddressedSafetyRelatedMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is used to send text messages to a specified vessel</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die verwendet wird, um Textnachrichten an ein bestimmtes Wasserfahrzeug zu senden</rdfs:comment>
        <rdfs:label xml:lang="en">Addressed safety-related message</rdfs:label>
        <rdfs:label xml:lang="de">addressierte, sicherheitsbezogene Nachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AssignedModeCommandMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AssignedModeCommandMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is used by base stations to assign a specific report bahavior</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht die von Basisstationen genutzt wird, um anderen AIS-Geräten bestimmte Meldeverhalten zuzuweisen</rdfs:comment>
        <rdfs:label xml:lang="en">Assigned mode command message</rdfs:label>
        <rdfs:label xml:lang="de">Nachricht zur Zuweisung eines Modus</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/BaseStationReportMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/BaseStationReportMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message sent by base stations to indicate their presence</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die von Basisstationen versendet wird, um deren Anwesenheit anzuzeigen</rdfs:comment>
        <rdfs:label xml:lang="en">Base station report message</rdfs:label>
        <rdfs:label xml:lang="de">Basisstationsreportnachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/BinaryAcknowledgeMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/BinaryAcknowledgeMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is sent to acknowledge the reception of a binary addressed message</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die als Empfangsbestätigung auf eine adressierte Binärnachricht gesendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">Binary acknowledge message</rdfs:label>
        <rdfs:label xml:lang="de">binäre Bestätigungsnachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/BinaryAddressedMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/BinaryAddressedMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is addressed point-to-point with unspecified binary payload</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die punkt-zu-punkt-adressiert ist und nicht näher spezifizierten Binär-Inhalt hat</rdfs:comment>
        <rdfs:label xml:lang="en">Binary addressed message</rdfs:label>
        <rdfs:label xml:lang="de">addressierte Binärnachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/BinaryBroadcastMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/BinaryBroadcastMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS-message with unspecified binary payload that is broadcast</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht mit nicht näher spezifiziertem binären Inhalt, die als Broadcast versendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">Binary broadcast message</rdfs:label>
        <rdfs:label xml:lang="de">binäre Broadcast-Nachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DataLinkManagementMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DataLinkManagementMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message used by a base station to manage the AIS slots</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die von Basisstationen zur Verwaltung von AIS-Zeitschlitzen verwendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">Data link management message</rdfs:label>
        <rdfs:label xml:lang="de">Nachricht zur Verwaltung von Datenverbindungen</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/ExtendedClassBEquipmentPositionReportMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/ExtendedClassBEquipmentPositionReportMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message used for position reports of class B legacy equipment</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht für Positionsreports von veralteter Ausrüstung der Klasse B</rdfs:comment>
        <rdfs:label xml:lang="en">Extended class B equipment position report message</rdfs:label>
        <rdfs:label xml:lang="de">Nachricht für erweiterte Positionsreports von Ausrüstung der Klasse B</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/GlobalNavigationSatelliteSystemBroadcastBinaryMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/GlobalNavigationSatelliteSystemBroadcastBinaryMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is sent by a base station to broadcast differential corrections for GPS</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die von Basisstationen zur differentiellen Korrektur des Global Positioning System versendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">Global navigation satellite system broadcast binary message</rdfs:label>
        <rdfs:label xml:lang="de">Navigationssatelliten-Binär-Broadcast-Nachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/InterrogationMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/InterrogationMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is used by a base station to get the status of up to two other AIS devices</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die von eine Basisstation zur Statusabfrage von bis zu zwei weiteren AIS-Geräten verwendet wird</rdfs:comment>
        <rdfs:label xml:lang="de">Abfragenachricht</rdfs:label>
        <rdfs:label xml:lang="en">Interrogation message</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Message -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Message"/>
    


    <!-- http://rescue-mate.de/ontology/PositionReportMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/PositionReportMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that reports navigational information</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die Navigationsinformationen übermittelt</rdfs:comment>
        <rdfs:label xml:lang="en">Position report message</rdfs:label>
        <rdfs:label xml:lang="de">Positionsreportnachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/SafetyRelatedAcknowledgeMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/SafetyRelatedAcknowledgeMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is sent in response to an addressed safety-related message</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die als Antwort auf eine addressierte, sicherheitsbezogene Nachricht gesendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">Safety-related acknowledge message</rdfs:label>
        <rdfs:label xml:lang="de">sicherheitsbezogene Empfangsbestätigungsnachricht</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/SafetyRelatedBroadcastMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/SafetyRelatedBroadcastMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is used to send text messages as a broadcast</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die zum Versenden von textuellen Inhalten als Broadcast-Nachricht verwendet wird</rdfs:comment>
        <rdfs:label xml:lang="de">Broadcast-Nachricht mit Sicherheitsbezug</rdfs:label>
        <rdfs:label xml:lang="en">Safety-related broadcast message</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/StandardClassBEquipmentPositionReportMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/StandardClassBEquipmentPositionReportMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that contains a less detailed report than normal position reports (types 1-3) for vessels using Class B transmitters</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die einen weniger detaillierten Positionsreport enthält als die normalen Positionsreportnachrichten (Typ 1-3), normalerweise gesendet von Wasserfahrzeugen mit Transmittern der Klasse B</rdfs:comment>
        <rdfs:label xml:lang="de">Positionsreportnachricht für Ausrüstung der Klasse B</rdfs:label>
        <rdfs:label xml:lang="en">Standard class B equipment position report message</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/StandardSearchAndRescueAircraftPositionReportMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/StandardSearchAndRescueAircraftPositionReportMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message used by an aircraft (helicopter or airplane) which is involved in a search and rescue operation on the sea (i.e. search for and recovery of survivors of an accident at sea)</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die von Luftfahrzeugen (Hubschrauber oder Flugzeug) in einem Such- und Rettungseinsatz (zum Finden und Retten von Überlebenden eines Unfalls) auf See verwendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">Standard search and rescue aircraft position report message</rdfs:label>
        <rdfs:label xml:lang="de">Standard-Report-Nachricht für Such- und Rettungsluftfahrzeuge</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/StaticAndVoyageRelatedDataMessage -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/StaticAndVoyageRelatedDataMessage">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that gives information on a ship and its trip</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht, die Informationen zu einem Schiff und dessen Reise enthält</rdfs:comment>
        <rdfs:label xml:lang="de">Nachricht für statische und reisebezogene Daten</rdfs:label>
        <rdfs:label xml:lang="en">Static and voyage related data message</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/UTC_DateInquiry -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/UTC_DateInquiry">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is used to obtain time and date from a base station</rdfs:comment>
        <rdfs:comment xml:lang="de">An AIS message that is used to obtain time and date from a base station

Eine AIS-Nachricht zur Abfrage von Zeit und Datum von einer Basisstation</rdfs:comment>
        <rdfs:label xml:lang="de">Anfrage von koordinierter Weltzeit/Datum</rdfs:label>
        <rdfs:label xml:lang="en">UTC/date inquiry</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/UTC_DateResponse -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/UTC_DateResponse">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AISMessage"/>
        <rdfs:comment xml:lang="en">An AIS message that is sent as a response to a UTC/date inquiry</rdfs:comment>
        <rdfs:comment xml:lang="de">Eine AIS-Nachricht die als Antwort auf eine Anfrage von koordinierter Weltzeit/Datum gesendet wird</rdfs:comment>
        <rdfs:label xml:lang="de">Mitteilung von koordinierter Weltzeit/Datum</rdfs:label>
        <rdfs:label xml:lang="en">UTC/date response</rdfs:label>
    </owl:Class>
</rdf:RDF>



