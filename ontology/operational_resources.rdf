    <!-- http://rescue-mate.de/ontology/sentFromDeviceWithIndividualShortSubscriberIdentity -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/sentFromDeviceWithIndividualShortSubscriberIdentity">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/FMSMessage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="de">gesendet von Gerät mit Individual Short Subscriber Identity (ISSI)</rdfs:label>
        <rdfs:label xml:lang="en">sent from device with individual short subscriber identity (ISSI)</rdfs:label>
    </owl:DatatypeProperty>
    


