    <!-- http://rescue-mate.de/ontology/AB -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AB">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Container"/>
        <rdfs:comment xml:lang="en">Container designed as a closed box that can accommodate specific loads (materials and tools) and/or can be used for the accommodation of people (furnished and with doors and windows)</rdfs:comment>
        <rdfs:comment xml:lang="de">Container, der als geschlossener Kasten ausgeführt ist und bestimmte Ladungen (Material und Werkzeug) aufnehmen oder/und für den Aufenthalt von Personen (möbliert und mit Türen und Fenstern) dienen kann</rdfs:comment>
        <rdfs:label xml:lang="de">Abrollbehälter</rdfs:label>
        <rdfs:label xml:lang="en">Abrollbehälter (Germany)</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AL16-4 -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AL16-4">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/FireFightingVehicle"/>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Trailer"/>
        <rdfs:comment xml:lang="de">Feuerwehranhänger mit Leiter mit einer Nennrettungshöhe von 16 Metern und Nennausladung von 4 Metern.</rdfs:comment>
        <rdfs:comment xml:lang="en">Fire service trailer with a ladder with a nominal rescue height of 16 meters and a nominal outreach of 4 meters.</rdfs:comment>
        <rdfs:label xml:lang="de">Anhängeleiter AL 16-4</rdfs:label>
        <rdfs:label xml:lang="en">Anhängeleiter AL 16-4 (Germany)</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AerialAppliance -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AerialAppliance">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/FireFightingVehicle"/>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/LandVehicle"/>
        <rdfs:comment xml:lang="de">Feuerwehrfahrzeug mit ausfahrbarer Leiter, Plattform oder ausfahrbarem Ausleger, das Feuerwehrleuten das Arbeiten in der Höhe zu Rettungs-, Lösch- und Zugangszwecken ermöglicht</rdfs:comment>
        <rdfs:comment xml:lang="en">Fire-fighting vehicle equipped with an extendable ladder, platform, or boom that allows firefighters to work at height for rescue, firefighting, and access purposes</rdfs:comment>
        <rdfs:label xml:lang="en">Aerial appliance</rdfs:label>
        <rdfs:label xml:lang="de">Hubrettungsfahrzeug</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AerialWorkPlatform -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AerialWorkPlatform">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AerialAppliance"/>
        <rdfs:comment xml:lang="en">Aerial appliance used to provide temporary access for people or equipment to inaccessible areas, usually at height.</rdfs:comment>
        <rdfs:comment xml:lang="de">Hubrettungsfahrzeug mit einer begehbaren und beweglichen Plattform über die Personen und Ausrüstung in die Nähe unzugänglicher Bereiche, insb. in größerer Höhe bewegt werden können</rdfs:comment>
        <rdfs:label xml:lang="en">Aerial work platform</rdfs:label>
        <rdfs:label xml:lang="de">Hubarbeitsbühne</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Aircraft -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Aircraft">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Vehicle"/>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q11436</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/ArrivedOnScene -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/ArrivedOnScene">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/EmergencyVehicleStatus"/>
        <obo:IAO_0000116>status 4 (rd/fw/pol)</obo:IAO_0000116>
        <rdfs:label xml:lang="de">Am Einsatzort eingetroffen</rdfs:label>
        <rdfs:label xml:lang="en">Arrived on scene</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AtDestination -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AtDestination">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/EmergencyVehicleStatus"/>
        <obo:IAO_0000116>status 8 (fw)</obo:IAO_0000116>
        <rdfs:label xml:lang="de">Am Zielort</rdfs:label>
        <rdfs:label xml:lang="en">At destination</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AtHospitalOrOtherDestination -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AtHospitalOrOtherDestination">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AtDestination"/>
        <obo:IAO_0000116>status 8 (rd)</obo:IAO_0000116>
        <rdfs:label xml:lang="en">At hospital or other destination</rdfs:label>
        <rdfs:label xml:lang="de">Im Krankenhaus/am Transportziel angekommen</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AtOtherLocation -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AtOtherLocation">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AtDestination"/>
        <obo:IAO_0000116>status 8 (pol)</obo:IAO_0000116>
        <rdfs:comment xml:lang="en">Patrol is committed at some other defined location, e.g. courthouse, duty point, escort assignment</rdfs:comment>
        <rdfs:label xml:lang="de">An anderem Einsatz-/Sprechort</rdfs:label>
        <rdfs:label xml:lang="en">At other location</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AvailableAtStation -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AvailableAtStation">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/EmergencyVehicleStatus"/>
        <obo:IAO_0000116>status 2 (rd/fw/pol)</obo:IAO_0000116>
        <rdfs:label xml:lang="en">Available at station</rdfs:label>
        <rdfs:label xml:lang="de">Einsatzbereit auf Wache</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AvailableOnRadio -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AvailableOnRadio">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/EmergencyVehicleStatus"/>
        <obo:IAO_0000116>status 1 (rd/fw/pol)</obo:IAO_0000116>
        <rdfs:label xml:lang="en">Available on radio</rdfs:label>
        <rdfs:label xml:lang="de">Einsatzbereit über Funk</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/BtLKW -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/BtLKW">
        <owl:equivalentClass rdf:resource="http://rescue-mate.de/ontology/GW-Bt"/>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/GW"/>
        <rdfs:label xml:lang="de">Betreuungslastkraftwagen</rdfs:label>
        <rdfs:label xml:lang="en">Betreuungslastkraftwagen (Germany)</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q831723</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/CBRN-ErkW -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/CBRN-ErkW">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/FireFightingVehicle"/>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/LandVehicle"/>
        <rdfs:comment xml:lang="de">Feuerwehrfahrzeug zur Detektion von radiologischen und chemischen Kontaminationen</rdfs:comment>
        <rdfs:comment xml:lang="en">Firefighting vehicle for the detection of radiological and chemical contamination</rdfs:comment>
        <rdfs:label xml:lang="de">CBRN-Erkundungswagen</rdfs:label>
        <rdfs:label xml:lang="en">CBRN-Erkundungswagen (Germany)</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q93978369</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/CommandVehicle -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/CommandVehicle">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/EmergencyVehicle"/>
        <rdfs:comment xml:lang="de">Einsatzfahrzeug zu Koordinierung des Einsatzes</rdfs:comment>
        <rdfs:comment xml:lang="en">emergency vehicle to coordinate fire, ambulance, police, and technical operations</rdfs:comment>
        <rdfs:label xml:lang="en">Command vehicle</rdfs:label>
        <rdfs:label xml:lang="de">Einsatzleitfahrzeug</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q1308813</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Container -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Container">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:comment xml:lang="de">Großraum-Behälter zur Lagerung und zum Transport von Gütern</rdfs:comment>
        <rdfs:comment xml:lang="en">Large-capacity freight unit for the storage and transport of goods</rdfs:comment>
        <rdfs:label xml:lang="de">Container</rdfs:label>
        <rdfs:label xml:lang="en">Container</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DL -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DL">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/FireFightingVehicle"/>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/LandVehicle"/>
        <rdfs:comment xml:lang="de">Feuerwehrfahrzeug mit einer fest installierten Leiter, die sich um 360 Grad drehen lässt</rdfs:comment>
        <rdfs:comment xml:lang="en">Fire-fighting vehicle with a ladder mounted on a pivot which resembles a turntable, able to rotate 360 degrees</rdfs:comment>
        <rdfs:label xml:lang="de">Drehleiter mit Handbetrieb</rdfs:label>
        <rdfs:label xml:lang="en">Drehleiter mit Handbetrieb (Germany)</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DLA -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DLA">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/TurntableLadder"/>
        <rdfs:comment xml:lang="de">Drehleiter mit automatisiertem Aufricht- und Abstützvorgang</rdfs:comment>
        <rdfs:comment xml:lang="en">Turntable ladder with automated erection and support process</rdfs:comment>
        <rdfs:label xml:lang="de">Vollautomatische Drehleiter</rdfs:label>
        <rdfs:label xml:lang="en">Vollautomatische Drehleiter (Germany)</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DLK -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DLK">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/TurntableLadder"/>
        <rdfs:comment xml:lang="de">Drehleiter mit einem Korb</rdfs:comment>
        <rdfs:comment xml:lang="en">Turntable ladder with basket</rdfs:comment>
        <rdfs:label xml:lang="de">Drehleiter mit Korb</rdfs:label>
        <rdfs:label xml:lang="en">Drehleiter mit Korb (Germany)</rdfs:label>
    </owl:Class>
