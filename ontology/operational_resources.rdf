<?xml version="1.0"?>
<rdf:RDF xmlns="http://rescue-mate.de/ontology/"
     xml:base="http://rescue-mate.de/ontology/"
     xmlns:cc="http://creativecommons.org/ns#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:dct="http://purl.org/dc/terms/"
     xmlns:fno="https://w3id.org/function/ontology#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:core="http://purl.org/vocab/frbr/core#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:schema="http://schema.org/"
     xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://rescue-mate.de/ontology/operational_resources">
        <owl:versionIRI rdf:resource="http://rescue-mate.de/ontology/operational_resources/0.6.0"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/bfo/2019-08-26/bfo.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/iao/2022-11-07/iao.owl"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/wikidata-bridge/0.6.0"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov-o-inverses-20130430"/>
        <cc:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dct:created>2025-02-12</dct:created>
        <dct:creator>Patrick Westphal</dct:creator>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-07</dct:issued>
        <dct:modified>2025-11-07</dct:modified>
        <dct:rights xml:lang="en">CC BY 4.0 - RESCUE-MATE Project</dct:rights>
        <dct:title xml:lang="en">RESCUE-MATE Ontology Module for Emergency Vehicles</dct:title>
        <dct:title xml:lang="de">RESCUE-MATE-Ontologie-Modul für Einsatzfahrzeuge</dct:title>
        <rdfs:comment xml:lang="de">Ontologie-Modul für Einsatzfahrzeuge zur Unterstützung der Datenintegration im RESCUE-MATE-Projekt</rdfs:comment>
        <rdfs:comment xml:lang="en">Main ontology module covering emergency vehicles to support the data integration part of the RESCUE-MATE project</rdfs:comment>
        <owl:priorVersion rdf:resource="http://rescue-mate.de/ontology/main/0.5.0"/>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</owl:versionInfo>
    </owl:Ontology>



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://creativecommons.org/ns#license -->

    <owl:AnnotationProperty rdf:about="http://creativecommons.org/ns#license"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/issued -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/rights -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/rights"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    

    <!-- http://rescue-mate.de/ontology/hasExternalID -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/hasExternalID">
        <rdfs:comment xml:lang="en">Assigns an ID that is external to the RESCUE-MATE data ecosystem</rdfs:comment>
        <rdfs:comment xml:lang="de">Weist eine ID zu, die außerhalb des RESCUE-MATE-Datenökosystems verwendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">has external ID</rdfs:label>
        <rdfs:label xml:lang="de">hat externe ID</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://rescue-mate.de/ontology/hasFMSStatusCode -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/hasFMSStatusCode">
        <rdfs:comment xml:lang="en">Annotates a FMS status message with its status code</rdfs:comment>
        <rdfs:comment xml:lang="de">Annotiert eine FMS-Status-Nachricht mit dem entsprechenden FMS-Status-Wert</rdfs:comment>
        <rdfs:label xml:lang="en">has FMS status code</rdfs:label>
        <rdfs:label xml:lang="de">hat FMS-Status-Wert</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/FMSMessage"/>
    </owl:AnnotationProperty>
    


    <!-- http://rescue-mate.de/ontology/hasResourceType -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/hasResourceType">
        <rdfs:comment xml:lang="en">Informally annotates an operational resource with a resource type</rdfs:comment>
        <rdfs:comment xml:lang="de">Informelle Annotation einer Einsatzressource mit einem Ressourcentyp</rdfs:comment>
        <rdfs:label xml:lang="en">has resource type</rdfs:label>
        <rdfs:label xml:lang="de">hat Ressourcen-Typ</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/OperationalResource"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/hasPosition -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/hasPosition">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/Position"/>
        <rdfs:comment xml:lang="de">Beziehung zwischen einem Objekt und einer Position (d.h. einem Raum-Zeit-Punkt)</rdfs:comment>
        <rdfs:comment xml:lang="en">Relation between an object and a position (being a point in space-time)</rdfs:comment>
        <rdfs:label xml:lang="en">has position</rdfs:label>
        <rdfs:label xml:lang="de">hat Position</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rescue-mate.de/ontology/statusAtPosition -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/statusAtPosition">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/EmergencyVehicleStatus"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/Position"/>
        <rdfs:comment xml:lang="de">Setzt den Status eines Einsatzfahrzeugs in Beziehung zur Position des Einsatzfahrzeugs</rdfs:comment>
        <rdfs:comment xml:lang="en">relates an emergency vehicle staus and a position</rdfs:comment>
        <rdfs:label xml:lang="de">Status an Position</rdfs:label>
        <rdfs:label xml:lang="en">status at position</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rescue-mate.de/ontology/vehicleHasState -->

    <owl:ObjectProperty rdf:about="http://rescue-mate.de/ontology/vehicleHasState">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/EmergencyVehicle"/>
        <rdfs:range rdf:resource="http://rescue-mate.de/ontology/EmergencyVehicleStatus"/>
        <rdfs:label xml:lang="de">Fahrzeug ist in Zustand</rdfs:label>
        <rdfs:label xml:lang="en">vehicle has state</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/sentFromDeviceWithIndividualShortSubscriberIdentity -->

    <owl:DatatypeProperty rdf:about="http://rescue-mate.de/ontology/sentFromDeviceWithIndividualShortSubscriberIdentity">
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/FMSMessage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="de">gesendet von Gerät mit Individual Short Subscriber Identity (ISSI)</rdfs:label>
        <rdfs:label xml:lang="en">sent from device with individual short subscriber identity (ISSI)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rescue-mate.de/ontology/AB -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AB">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Container"/>
        <rdfs:comment xml:lang="en">Container designed as a closed box that can accommodate specific loads (materials and tools) and/or can be used for the accommodation of people (furnished and with doors and windows)</rdfs:comment>
        <rdfs:comment xml:lang="de">Container, der als geschlossener Kasten ausgeführt ist und bestimmte Ladungen (Material und Werkzeug) aufnehmen oder/und für den Aufenthalt von Personen (möbliert und mit Türen und Fenstern) dienen kann</rdfs:comment>
        <rdfs:label xml:lang="de">Abrollbehälter</rdfs:label>
        <rdfs:label xml:lang="en">Abrollbehälter (Germany)</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AL16-4 -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AL16-4">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/FireFightingVehicle"/>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Trailer"/>
        <rdfs:comment xml:lang="de">Feuerwehranhänger mit Leiter mit einer Nennrettungshöhe von 16 Metern und Nennausladung von 4 Metern.</rdfs:comment>
        <rdfs:comment xml:lang="en">Fire service trailer with a ladder with a nominal rescue height of 16 meters and a nominal outreach of 4 meters.</rdfs:comment>
        <rdfs:label xml:lang="de">Anhängeleiter AL 16-4</rdfs:label>
        <rdfs:label xml:lang="en">Anhängeleiter AL 16-4 (Germany)</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AerialAppliance -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AerialAppliance">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/FireFightingVehicle"/>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/LandVehicle"/>
        <rdfs:comment xml:lang="de">Feuerwehrfahrzeug mit ausfahrbarer Leiter, Plattform oder ausfahrbarem Ausleger, das Feuerwehrleuten das Arbeiten in der Höhe zu Rettungs-, Lösch- und Zugangszwecken ermöglicht</rdfs:comment>
        <rdfs:comment xml:lang="en">Fire-fighting vehicle equipped with an extendable ladder, platform, or boom that allows firefighters to work at height for rescue, firefighting, and access purposes</rdfs:comment>
        <rdfs:label xml:lang="en">Aerial appliance</rdfs:label>
        <rdfs:label xml:lang="de">Hubrettungsfahrzeug</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AerialWorkPlatform -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AerialWorkPlatform">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AerialAppliance"/>
        <rdfs:comment xml:lang="en">Aerial appliance used to provide temporary access for people or equipment to inaccessible areas, usually at height.</rdfs:comment>
        <rdfs:comment xml:lang="de">Hubrettungsfahrzeug mit einer begehbaren und beweglichen Plattform über die Personen und Ausrüstung in die Nähe unzugänglicher Bereiche, insb. in größerer Höhe bewegt werden können</rdfs:comment>
        <rdfs:label xml:lang="en">Aerial work platform</rdfs:label>
        <rdfs:label xml:lang="de">Hubarbeitsbühne</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Aircraft -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Aircraft">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/Vehicle"/>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q11436</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/ArrivedOnScene -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/ArrivedOnScene">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/EmergencyVehicleStatus"/>
        <obo:IAO_0000116>status 4 (rd/fw/pol)</obo:IAO_0000116>
        <rdfs:label xml:lang="de">Am Einsatzort eingetroffen</rdfs:label>
        <rdfs:label xml:lang="en">Arrived on scene</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AtDestination -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AtDestination">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/EmergencyVehicleStatus"/>
        <obo:IAO_0000116>status 8 (fw)</obo:IAO_0000116>
        <rdfs:label xml:lang="de">Am Zielort</rdfs:label>
        <rdfs:label xml:lang="en">At destination</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AtHospitalOrOtherDestination -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AtHospitalOrOtherDestination">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AtDestination"/>
        <obo:IAO_0000116>status 8 (rd)</obo:IAO_0000116>
        <rdfs:label xml:lang="en">At hospital or other destination</rdfs:label>
        <rdfs:label xml:lang="de">Im Krankenhaus/am Transportziel angekommen</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AtOtherLocation -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AtOtherLocation">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/AtDestination"/>
        <obo:IAO_0000116>status 8 (pol)</obo:IAO_0000116>
        <rdfs:comment xml:lang="en">Patrol is committed at some other defined location, e.g. courthouse, duty point, escort assignment</rdfs:comment>
        <rdfs:label xml:lang="de">An anderem Einsatz-/Sprechort</rdfs:label>
        <rdfs:label xml:lang="en">At other location</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AvailableAtStation -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AvailableAtStation">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/EmergencyVehicleStatus"/>
        <obo:IAO_0000116>status 2 (rd/fw/pol)</obo:IAO_0000116>
        <rdfs:label xml:lang="en">Available at station</rdfs:label>
        <rdfs:label xml:lang="de">Einsatzbereit auf Wache</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/AvailableOnRadio -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/AvailableOnRadio">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/EmergencyVehicleStatus"/>
        <obo:IAO_0000116>status 1 (rd/fw/pol)</obo:IAO_0000116>
        <rdfs:label xml:lang="en">Available on radio</rdfs:label>
        <rdfs:label xml:lang="de">Einsatzbereit über Funk</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/BtLKW -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/BtLKW">
        <owl:equivalentClass rdf:resource="http://rescue-mate.de/ontology/GW-Bt"/>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/GW"/>
        <rdfs:label xml:lang="de">Betreuungslastkraftwagen</rdfs:label>
        <rdfs:label xml:lang="en">Betreuungslastkraftwagen (Germany)</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q831723</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/CBRN-ErkW -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/CBRN-ErkW">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/FireFightingVehicle"/>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/LandVehicle"/>
        <rdfs:comment xml:lang="de">Feuerwehrfahrzeug zur Detektion von radiologischen und chemischen Kontaminationen</rdfs:comment>
        <rdfs:comment xml:lang="en">Firefighting vehicle for the detection of radiological and chemical contamination</rdfs:comment>
        <rdfs:label xml:lang="de">CBRN-Erkundungswagen</rdfs:label>
        <rdfs:label xml:lang="en">CBRN-Erkundungswagen (Germany)</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q93978369</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/CommandVehicle -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/CommandVehicle">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/EmergencyVehicle"/>
        <rdfs:comment xml:lang="de">Einsatzfahrzeug zu Koordinierung des Einsatzes</rdfs:comment>
        <rdfs:comment xml:lang="en">emergency vehicle to coordinate fire, ambulance, police, and technical operations</rdfs:comment>
        <rdfs:label xml:lang="en">Command vehicle</rdfs:label>
        <rdfs:label xml:lang="de">Einsatzleitfahrzeug</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q1308813</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/Container -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/Container">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:comment xml:lang="de">Großraum-Behälter zur Lagerung und zum Transport von Gütern</rdfs:comment>
        <rdfs:comment xml:lang="en">Large-capacity freight unit for the storage and transport of goods</rdfs:comment>
        <rdfs:label xml:lang="de">Container</rdfs:label>
        <rdfs:label xml:lang="en">Container</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DL -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DL">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/FireFightingVehicle"/>
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/LandVehicle"/>
        <rdfs:comment xml:lang="de">Feuerwehrfahrzeug mit einer fest installierten Leiter, die sich um 360 Grad drehen lässt</rdfs:comment>
        <rdfs:comment xml:lang="en">Fire-fighting vehicle with a ladder mounted on a pivot which resembles a turntable, able to rotate 360 degrees</rdfs:comment>
        <rdfs:label xml:lang="de">Drehleiter mit Handbetrieb</rdfs:label>
        <rdfs:label xml:lang="en">Drehleiter mit Handbetrieb (Germany)</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DLA -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DLA">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/TurntableLadder"/>
        <rdfs:comment xml:lang="de">Drehleiter mit automatisiertem Aufricht- und Abstützvorgang</rdfs:comment>
        <rdfs:comment xml:lang="en">Turntable ladder with automated erection and support process</rdfs:comment>
        <rdfs:label xml:lang="de">Vollautomatische Drehleiter</rdfs:label>
        <rdfs:label xml:lang="en">Vollautomatische Drehleiter (Germany)</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DLK -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DLK">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/TurntableLadder"/>
        <rdfs:comment xml:lang="de">Drehleiter mit einem Korb</rdfs:comment>
        <rdfs:comment xml:lang="en">Turntable ladder with basket</rdfs:comment>
        <rdfs:label xml:lang="de">Drehleiter mit Korb</rdfs:label>
        <rdfs:label xml:lang="en">Drehleiter mit Korb (Germany)</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DLK12-9 -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DLK12-9">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/DLK"/>
        <rdfs:comment xml:lang="de">Drehleiter mit Korb und einer Nennrettungshöhe von 12 Metern bei 9 Metern Nennausladung</rdfs:comment>
        <rdfs:comment xml:lang="en">Turntable ladder with a basket, a nominal rescue height of 12 meters, and a nominal outreach of 9 meters</rdfs:comment>
        <rdfs:label xml:lang="de">Drehleiter mit Korb 12/9</rdfs:label>
        <rdfs:label xml:lang="en">Drehleiter mit Korb 12/9 (Germany)</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DLK18-12 -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DLK18-12">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/DLK"/>
        <rdfs:comment xml:lang="de">Drehleiter mit Korb und einer Nennrettungshöhe von 18 Metern bei 12 Metern Nennausladung</rdfs:comment>
        <rdfs:comment xml:lang="en">Turntable ladder with a basket, a nominal rescue height of 18 meters, and a nominal outreach of 12 meters</rdfs:comment>
        <rdfs:label xml:lang="de">Drehleiter mit Korb 18/12</rdfs:label>
        <rdfs:label xml:lang="en">Drehleiter mit Korb 18/12 (Germany)</rdfs:label>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DLK23-12 -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DLK23-12">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/DLK"/>
        <rdfs:comment xml:lang="de">Drehleiter mit Korb und einer Nennrettungshöhe von 23 Metern bei 12 Metern Nennausladung</rdfs:comment>
        <rdfs:comment xml:lang="en">Turntable ladder with a basket, a nominal rescue height of 23 meters, and a nominal outreach of 12 meters</rdfs:comment>
        <rdfs:label xml:lang="de">Drehleiter mit Korb 23/12</rdfs:label>
        <rdfs:label xml:lang="en">Drehleiter mit Korb 23/12 (Germany)</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q50659049</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://rescue-mate.de/ontology/DLS -->

    <owl:Class rdf:about="http://rescue-mate.de/ontology/DLS">
        <rdfs:subClassOf rdf:resource="http://rescue-mate.de/ontology/TurntableLadder"/>
        <rdfs:comment xml:lang="de">Drehleiter, die nur eine Bewegung zur selben Zeit ausführen kann</rdfs:comment>
        <rdfs:comment xml:lang="en">Turntable ladder that can only perform one movement at a time</rdfs:comment>
        <rdfs:label xml:lang="de">Sequenzielle (halbautomatische) Drehleiter</rdfs:label>
        <rdfs:label xml:lang="en">Sequenzielle (halbautomatische) Drehleiter (Germany)</rdfs:label>
    </owl:Class>
    


