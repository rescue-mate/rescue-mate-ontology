    <owl:Ontology rdf:about="http://rescue-mate.de/ontology/operational_resources">
        <owl:versionIRI rdf:resource="http://rescue-mate.de/ontology/operational_resources/0.6.0"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/bfo/2019-08-26/bfo.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/iao/2022-11-07/iao.owl"/>
        <owl:imports rdf:resource="http://rescue-mate.de/ontology/wikidata-bridge/0.6.0"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov-o-inverses-20130430"/>
        <cc:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dct:created>2025-02-12</dct:created>
        <dct:creator>Patrick Westphal</dct:creator>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-07</dct:issued>
        <dct:modified>2025-11-07</dct:modified>
        <dct:rights xml:lang="en">CC BY 4.0 - RESCUE-MATE Project</dct:rights>
        <dct:title xml:lang="en">RESCUE-MATE Ontology Module for Emergency Vehicles</dct:title>
        <dct:title xml:lang="de">RESCUE-MATE-Ontologie-Modul für Einsatzfahrzeuge</dct:title>
        <rdfs:comment xml:lang="de">Ontologie-Modul für Einsatzfahrzeuge zur Unterstützung der Datenintegration im RESCUE-MATE-Projekt</rdfs:comment>
        <rdfs:comment xml:lang="en">Main ontology module covering emergency vehicles to support the data integration part of the RESCUE-MATE project</rdfs:comment>
        <owl:priorVersion rdf:resource="http://rescue-mate.de/ontology/main/0.5.0"/>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</owl:versionInfo>
    </owl:Ontology>



