    <!-- http://rescue-mate.de/ontology/hasExternalID -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/hasExternalID">
        <rdfs:comment xml:lang="en">Assigns an ID that is external to the RESCUE-MATE data ecosystem</rdfs:comment>
        <rdfs:comment xml:lang="de">Weist eine ID zu, die außerhalb des RESCUE-MATE-Datenökosystems verwendet wird</rdfs:comment>
        <rdfs:label xml:lang="en">has external ID</rdfs:label>
        <rdfs:label xml:lang="de">hat externe ID</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://rescue-mate.de/ontology/hasFMSStatusCode -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/hasFMSStatusCode">
        <rdfs:comment xml:lang="en">Annotates a FMS status message with its status code</rdfs:comment>
        <rdfs:comment xml:lang="de">Annotiert eine FMS-Status-Nachricht mit dem entsprechenden FMS-Status-Wert</rdfs:comment>
        <rdfs:label xml:lang="en">has FMS status code</rdfs:label>
        <rdfs:label xml:lang="de">hat FMS-Status-Wert</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/FMSMessage"/>
    </owl:AnnotationProperty>
    


    <!-- http://rescue-mate.de/ontology/hasResourceType -->

    <owl:AnnotationProperty rdf:about="http://rescue-mate.de/ontology/hasResourceType">
        <rdfs:comment xml:lang="en">Informally annotates an operational resource with a resource type</rdfs:comment>
        <rdfs:comment xml:lang="de">Informelle Annotation einer Einsatzressource mit einem Ressourcentyp</rdfs:comment>
        <rdfs:label xml:lang="en">has resource type</rdfs:label>
        <rdfs:label xml:lang="de">hat Ressourcen-Typ</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="http://rescue-mate.de/ontology/OperationalResource"/>
    </owl:AnnotationProperty>
    


